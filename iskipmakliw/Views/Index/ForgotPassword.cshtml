@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_Layout"; // Adjust to your layout
}

<div class="page-wrapper">
    <div class="page-body">
        <div class="container container-tight py-6">
            <div class="text-center mb-4">
                <a href="/" class="navbar-brand navbar-brand-autodark">
                    <!-- Your Logo Here -->
                </a>
            </div>
            <div class="row row-deck row-cards">
                <div class="col-12">
                    <form method="post" asp-action="SendResetLink" id="forgotForm" class="card card-md">
                        <div class="card-body">
                            <div class="card-title text-center mb-4">
                                <h2>Forgot your password?</h2>
                            </div>

                            @if (TempData["Success"] != null)
                            {
                                <div class="alert alert-success alert-dismissible" role="alert">
                                    <div class="d-flex">
                                        <div>
                                            <svg xmlns="http://www.w3.org/2000/svg" class="icon alert-icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" /><path d="M9 12l2 2l4 -4" /></svg>
                                        </div>
                                        <div>
                                            <h4 class="alert-title">Success</h4>
                                            <div class="text-muted">@TempData["Success"]</div>
                                        </div>
                                    </div>
                                    <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
                                </div>
                            }

                            @if (TempData["Error"] != null)
                            {
                                <div class="alert alert-danger alert-dismissible" role="alert">
                                    <div class="d-flex">
                                        <div>
                                            <svg xmlns="http://www.w3.org/2000/svg" class="icon alert-icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" /><path d="M12 8v4" /><path d="M12 16v.01" /></svg>
                                        </div>
                                        <div>
                                            <h4 class="alert-title">Error</h4>
                                            <div class="text-muted">@TempData["Error"]</div>
                                        </div>
                                    </div>
                                    <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
                                </div>
                            }

                            <p class="text-muted text-center mb-4">
                                Enter your email address and we'll send you a link to reset your password.
                            </p>

                            <div class="mb-3">
                                <label class="form-label">Email address</label>
                                <input type="email" 
                                       class="form-control" 
                                       id="email" 
                                       name="email" 
                                       placeholder="your@email.com"
                                       required>
                            </div>

                            <div class="form-footer">
                                <button type="submit" class="btn btn-primary w-100">
                                    Send Password Reset Link
                                </button>
                            </div>
                        </div>
                    </form>

                    <div class="text-center text-muted mt-3">
                        Remember your password? 
                        <a href="@Url.Action("Login", "Account")" tabindex="-1">
                            Sign in
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

