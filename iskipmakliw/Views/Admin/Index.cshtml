@using iskipmakliw.Models.ViewModels
@model AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_Layout";
}

<div class="page-wrapper">
    <div class="page-body">
        <div class="container-xl">
            <!-- Page Header -->
            <div class="page-header d-print-none">
                <div class="row align-items-center">
                    <div class="col">
                        <h2 class="page-title">
                            Dashboard
                        </h2>
                    </div>
                </div>
            </div>
        </div>

        <div class="page-body">
            <div class="container-xl">
                <!-- Stats Row -->
                <div class="row row-deck row-cards">
                    <div class="col-sm-6 col-lg-3">
                        <div class="card">
                            <div class="card-body">
                                <div class="text-truncate">
                                    <h3 class="card-title text-muted fs-6 fw-normal">
                                        Total Subscribers
                                    </h3>
                                </div>
                                <div class="d-flex align-items-baseline">
                                    <div class="h1 mb-0 me-2">@Model.TotalSubscribers</div>
                                    <div class="text-green text-truncate">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 17 9 11 13 15 21 7"></polyline><polyline points="21 7 21 3 17 3"></polyline></svg>
                                        12%
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-lg-3">
                        <div class="card">
                            <div class="card-body">
                                <div class="text-truncate">
                                    <h3 class="card-title text-muted fs-6 fw-normal">
                                        Active Subscriptions
                                    </h3>
                                </div>
                                <div class="d-flex align-items-baseline">
                                    <div class="h1 mb-0 me-2">@Model.ActiveSubscriptions</div>
                                    <div class="text-green text-truncate">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 17 9 11 13 15 21 7"></polyline><polyline points="21 7 21 3 17 3"></polyline></svg>
                                        8%
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-lg-3">
                        <div class="card">
                            <div class="card-body">
                                <div class="text-truncate">
                                    <h3 class="card-title text-muted fs-6 fw-normal">
                                        Pending Riders
                                    </h3>
                                </div>
                                <div class="d-flex align-items-baseline">
                                    <div class="h1 mb-0 me-2">@Model.PendingRiders</div>
                                    <div class="text-orange text-truncate">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 7 9 13 13 9 21 17"></polyline><polyline points="21 17 21 21 17 21"></polyline></svg>
                                        Pending Review
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-sm-6 col-lg-3">
                        <div class="card">
                            <div class="card-body">
                                <div class="text-truncate">
                                    <h3 class="card-title text-muted fs-6 fw-normal">
                                        Total Customers
                                    </h3>
                                </div>
                                <div class="d-flex align-items-baseline">
                                    <div class="h1 mb-0 me-2">@Model.TotalCustomers</div>
                                    <div class="text-green text-truncate">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 17 9 11 13 15 21 7"></polyline><polyline points="21 7 21 3 17 3"></polyline></svg>
                                        15%
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Chart Row -->
                <div class="row row-deck row-cards mt-2">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h3 class="card-title">Subscriber Growth (Last 12 Months)</h3>
                            </div>
                            <div class="card-body">
                                <div id="subscriberChart" style="height: 300px;"></div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Data Tables Row -->
                <div class="row row-deck row-cards mt-2">
                    <!-- Recent Subscribers -->
                    <div class="col-12 col-lg-6">
                        <div class="card">
                            <div class="card-header">
                                <h3 class="card-title">Recent Subscribers (Last 7 Days)</h3>
                            </div>
                            <div class="table-responsive">
                                <table class="table card-table table-vcenter">
                                    <thead>
                                        <tr>
                                            <th>Email</th>
                                            <th>Plan</th>
                                            <th>Date</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.RecentSubscribers.Any())
                                        {
                                            @foreach (var subscriber in Model.RecentSubscribers)
                                            {
                                                <tr>
                                                    <td>
                                                        <div class="text-truncate">
                                                            <a href="#" class="text-reset">@subscriber.Email</a>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-blue-lt">@subscriber.Subscription.FirstOrDefault().Plans.PlanName</span>
                                                    </td>
                                                    <td>
                                                        <small class="text-muted">@subscriber.DateCreated.ToString("MMM dd, yyyy")</small>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-green-lt">Active</span>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="4" class="text-center text-muted py-4">
                                                    No recent subscribers
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Purchased Plans -->
                    <div class="col-12 col-lg-6">
                        <div class="card">
                            <div class="card-header">
                                <h3 class="card-title">Purchased Plans</h3>
                            </div>
                            <div class="table-responsive">
                                <table class="table card-table table-vcenter">
                                    <thead>
                                        <tr>
                                            <th>Customer</th>
                                            <th>Plan</th>
                                            <th>Amount</th>
                                            <th>Date</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.PurchasedPlans.Any() && Model.PurchasedPlans.Count > 0)
                                        {
                                            @foreach (var plan in Model.PurchasedPlans)
                                            {
                                                <tr>
                                                    <td>
                                                        <div>
                                                            <a href="#" class="text-reset">@plan.Username</a>
                                                        </div>
                                                        <small class="text-muted">@plan.Email</small>
                                                    </td>
                                                    <td>
                                                        <span class="badge bg-purple-lt">@plan.Subscription?.FirstOrDefault()?.Plans.PlanName</span>
                                                    </td>
                                                    <td>
                                                        <strong>₱@plan.Subscription?.FirstOrDefault()?.Plans.Price</strong>
                                                    </td>
                                                    <td>
                                                        <small class="text-muted">@plan.DateCreated.ToString("MMM dd, yyyy")</small>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="4" class="text-center text-muted py-4">
                                                    No plan purchases
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Riders and Customers Row -->
                <div class="row row-deck row-cards mt-2">
                    <!-- Rider Applications -->
                    <div class="col-12 col-lg-6">
                        <div class="card">
                            <div class="card-header">
                                <h3 class="card-title">Rider Applications</h3>
                            </div>
                            <div class="table-responsive">
                                <table class="table card-table table-vcenter">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Status</th>
                                            <th>Applied</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.RiderApplications.Any())
                                        {
                                            @foreach (var rider in Model.RiderApplications)
                                            {
                                                <tr>
                                                    <td>
                                                        <div>
                                                            <a href="#" class="text-reset">@rider.Username</a>
                                                        </div>
                                                        <small class="text-muted">@rider.ContactNumber</small>
                                                    </td>
                                                    <td>
                                                        @{
                                                            var statusColor = rider.UserDetails.Status == "Approved" ? "success" :
                                                            rider.UserDetails.Status == "Rejected" ? "danger" : "warning";
                                                        }
                                                        <span class="badge bg-@(statusColor)">@rider.UserDetails.Status</span>
                                                    </td>
                                                    <td>
                                                        <small class="text-muted">@rider.DateCreated.ToString("MMM dd, yyyy")</small>
                                                    </td>
                                                    <td>
                                                        @if (rider.UserDetails.Status == "Pending")
                                                        {
                                                            <a asp-action="Riders" class="btn btn-icon btn-ghost-primary btn-sm">
                                                                <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" /><path d="M12 7v5l3 3" /></svg>
                                                            </a>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="4" class="text-center text-muted py-4">
                                                    No rider applications
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Recent Customers -->
                    <div class="col-12 col-lg-6">
                        <div class="card">
                            <div class="card-header">
                                <h3 class="card-title">Recently Registered Customers</h3>
                                <div class="card-options">
                                    <a href="#" class="btn-icon btn btn-ghost-primary">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="icon" width="24" height="24" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="12 3 20 7.5 20 16.5 12 21 4 16.5 4 7.5 12 3"></polyline><line x1="12" y1="12" x2="20" y2="7.5"></line><line x1="12" y1="12" x2="12" y2="21"></line><line x1="12" y1="12" x2="4" y2="7.5"></line></svg>
                                    </a>
                                </div>
                            </div>
                            <div class="table-responsive">
                                <table class="table card-table table-vcenter">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Email</th>
                                            <th>Phone</th>
                                            <th>Registered</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.RecentCustomers.Any())
                                        {
                                            @foreach (var customer in Model.RecentCustomers)
                                            {
                                                <tr>
                                                    <td>
                                                        <a href="#" class="text-reset">@customer.Username</a>
                                                    </td>
                                                    <td>
                                                        <small class="text-muted">@customer.Email</small>
                                                    </td>
                                                    <td>
                                                        <small class="text-muted">@customer.ContactNumber</small>
                                                    </td>
                                                    <td>
                                                        <small class="text-muted">@customer.DateCreated.ToString("MMM dd, yyyy")</small>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="4" class="text-center text-muted py-4">
                                                    No recent customers
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- ApexCharts -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/apexcharts/3.45.0/apexcharts.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Prepare data
            const months = [@Html.Raw(string.Join(",", Model.MonthlySubscriberData.Select(m => $"\"{m.Month}\"")))];
            const counts = [@Html.Raw(string.Join(",", Model.MonthlySubscriberData.Select(m => m.Count)))];

            // Subscriber Chart
            const options = {
                chart: {
                    type: 'area',
                    height: 300,
                    sparkline: {
                        enabled: false
                    },
                    toolbar: {
                        show: false
                    }
                },
                colors: ['#0d6efd'],
                series: [{
                    name: 'Subscribers',
                    data: counts
                }],
                xaxis: {
                    categories: months,
                    labels: {
                        style: {
                            colors: '#9ca3af'
                        }
                    }
                },
                yaxis: {
                    labels: {
                        style: {
                            colors: '#9ca3af'
                        }
                    }
                },
                fill: {
                    type: 'gradient',
                    gradient: {
                        shadeIntensity: 1,
                        opacityFrom: 0.45,
                        opacityTo: 0.05,
                        stops: [20, 100, 100, 100]
                    }
                },
                stroke: {
                    curve: 'smooth',
                    width: 2
                },
                grid: {
                    borderColor: '#e5e7eb',
                    row: {
                        colors: ['transparent'],
                        opacity: 0.5
                    }
                }
            };

            const chart = new ApexCharts(document.querySelector("#subscriberChart"), options);
            chart.render();
        });
    </script>
}
