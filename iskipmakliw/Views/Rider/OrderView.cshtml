@{
    Layout = "_LayoutRider";
}

@model DeliverProduct
@if(Model.PurchasedProduct.ProductVariantsId != null)
{
    <div class="row mt-4">
        <!-- Order Info -->
        <div class="col-xl-4 col-lg-5 col-md-12 mt-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">Order Information</h5>
                    <ul class="list-unstyled mb-0">
                        <li><strong>Order ID:</strong> @Model.Id</li>
                        <li><strong>Customer:</strong> @Model.PurchasedProduct?.Billings?.Name</li>
                        <li><strong>Product:</strong> @Model.PurchasedProduct?.ProductVariants?.Material - @Model.PurchasedProduct?.ProductVariants?.Product?.Name</li>
                        <li><strong>Price:</strong> ₱@Model.PurchasedProduct?.Price</li>
                        <li><strong>Status:</strong> <span class="badge bg-primary">@Model.Status</span></li>
                        <li><strong>Shipping Fee:</strong> <span class="badge bg-warning">₱@(Model.PurchasedProduct?.ShippingFee > 0 ? Model.PurchasedProduct?.ShippingFee : 50)</span></li>
                    </ul>
                </div>
            </div>

            <div class="card shadow-sm border-0 mt-3">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">Location Details</h5>
                    <p class="mb-2"><strong>Pickup Address:</strong><br>@Model.PurchasedProduct.ProductVariants.Product.Users.UserDetails.Address</p>
                    <p class="mb-2"><strong>Drop-off Address:</strong><br>@Model.PurchasedProduct.Billings.Address</p>
                    <p><strong>Distance:</strong> <span id="distance">Calculating...</span></p>
                </div>
            </div>
            <form asp-action="OrderView" asp-controller="Rider" method="post">
                <button type="submit" class="mt-3 btn btn-secondary w-100">
                    Accept
                </button>
            </form>
        </div>

        <!-- Map Section -->
        <div class="col-xl-8 col-lg-7 col-md-12 mt-3">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Delivery Route</h5>
                </div>
                <div class="card-body p-3">
                    <div id="order-map" style="height: 500px; width: 100%; border-radius: 0 0 8px 8px;"></div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <!-- ✅ Ensure Leaflet and Routing Machine are loaded -->
        <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
        <script src="https://unpkg.com/leaflet-routing-machine/dist/leaflet-routing-machine.js"></script>

        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const dropoffLat = @Model.PurchasedProduct.Billings.Latitude;
                const dropoffLng = @Model.PurchasedProduct.Billings.Longitude;
                const pickupLat = @Model.PurchasedProduct.ProductVariants.Product.Users.UserDetails.Latitude;
                const pickupLng = @Model.PurchasedProduct.ProductVariants.Product.Users.UserDetails.Longitude;

                const map = L.map('order-map').setView([pickupLat, pickupLng], 13);

                // Add base map layer
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '&copy; OpenStreetMap contributors'
                }).addTo(map);

                // Pickup marker
                const pickupMarker = L.marker([pickupLat, pickupLng], {
                    title: "Pickup Location",
                    icon: L.icon({
                        iconUrl: 'https://cdn-icons-png.flaticon.com/512/149/149059.png',
                        iconSize: [32, 32],
                        iconAnchor: [16, 32]
                    })
                }).addTo(map).bindPopup("<b>Pickup Location</b><br>@Model.PurchasedProduct.ProductVariants.Product.Users.UserDetails.Address");

                // Drop-off marker
                const dropoffMarker = L.marker([dropoffLat, dropoffLng], {
                    title: "Drop-off Location",
                    icon: L.icon({
                        iconUrl: 'https://cdn-icons-png.flaticon.com/512/684/684908.png',
                        iconSize: [32, 32],
                        iconAnchor: [16, 32]
                    })
                }).addTo(map).bindPopup("<b>Drop-off Location</b><br>@Model.PurchasedProduct.Billings.Address");

                // --- Routing without summary ---
                const routingControl = L.Routing.control({
                    waypoints: [
                        L.latLng(pickupLat, pickupLng),
                        L.latLng(dropoffLat, dropoffLng)
                    ],
                    lineOptions: {
                        styles: [{ color: '#007bff', weight: 5, opacity: 0.8 }]
                    },
                    addWaypoints: false,
                    draggableWaypoints: false,
                    routeWhileDragging: false,
                    fitSelectedRoutes: true,
                    createMarker: function () { return null; },
                    show: false,
                    collapsible: true,
                    router: L.Routing.osrmv1({
                        serviceUrl: 'https://router.project-osrm.org/route/v1'
                    })
                }).addTo(map);

                // Remove the default route summary panel
                routingControl.on('routeselected', function () {
                    const container = document.querySelector('.leaflet-routing-container');
                    if (container) container.style.display = 'none';
                });

                // Update distance when route is found
                routingControl.on('routesfound', function (e) {
                    const route = e.routes[0];
                    const distanceKm = route.summary.totalDistance / 1000;
                    document.getElementById("distance").textContent = distanceKm.toFixed(2) + " km (by road)";
                });

                setTimeout(() => map.invalidateSize(), 400);
                setTimeout(() => map.invalidateSize(), 800);
            });
        </script>
    }
}
