@{
    // 📅 Daily: Group by date (yyyy-MM-dd)
    var dailyData = Model
     .Where(x => x.DeliveredOn != null)
     .GroupBy(x => x.DeliveredOn.Value.Date)
     .OrderBy(g => g.Key) // ✅ Order by date before projection
     .Select(g => new { Label = g.Key.ToString("MMM dd"), Count = g.Count() })
     .ToList();

    // 📆 Weekly: Group by ISO week number
    var weeklyData = Model
        .Where(x => x.DeliveredOn != null)
        .GroupBy(x => System.Globalization.CultureInfo.CurrentCulture.Calendar.GetWeekOfYear(
            x.DeliveredOn.Value,
            System.Globalization.CalendarWeekRule.FirstFourDayWeek,
            DayOfWeek.Monday))
        .Select(g => new { Label = "Week " + g.Key, Count = g.Count() })
        .OrderBy(x => x.Label)
        .ToList();

    // 🗓️ Monthly: Group by year + month
    var monthlyData = Model
        .Where(x => x.DeliveredOn != null)
        .GroupBy(x => new { x.DeliveredOn.Value.Year, x.DeliveredOn.Value.Month })
        .Select(g => new { Label = new DateTime(g.Key.Year, g.Key.Month, 1).ToString("MMM yyyy"), Count = g.Count() })
        .OrderBy(x => x.Label)
        .ToList();
}


@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
               $("#Remit").on("click", function () {
            Swal.fire({
                title: "Are you sure?",
                text: "This will remit all unremitted products.",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Yes, remit all",
                cancelButtonText: "Cancel",
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: "Rider/Remit",
                        method: "POST",
                        success: function (response) {
                            location.reload();
                        },
                        error: function (xhr) {
                            Swal.fire({
                                title: "Error!",
                                text: "An error occurred while remitting. Please try again.",
                                icon: "error"
                            });
                            console.log(xhr.responseText);
                        }
                    });
                }
            });
        });

        // ✅ Prepare datasets (Razor → JS)
        const dailyData = {
            labels: @Html.Raw(Json.Serialize(dailyData.Select(x => x.Label))),
            data: @Html.Raw(Json.Serialize(dailyData.Select(x => x.Count)))
        };
        const weeklyData = {
            labels: @Html.Raw(Json.Serialize(weeklyData.Select(x => x.Label))),
            data: @Html.Raw(Json.Serialize(weeklyData.Select(x => x.Count)))
        };
        const monthlyData = {
            labels: @Html.Raw(Json.Serialize(monthlyData.Select(x => x.Label))),
            data: @Html.Raw(Json.Serialize(monthlyData.Select(x => x.Count)))
        };

        // 🧾 Initialize chart
        const ctx = document.getElementById('revenueChart');
        let currentDataset = dailyData;

                let chart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: currentDataset.labels,
                datasets: [{
                    label: 'Number of Deliveries',
                    data: currentDataset.data,
                    borderWidth: 1,
                    backgroundColor: 'rgba(54, 162, 235, 0.6)'
                }]
            },
            options: {
                responsive: true,           // ✅ Makes chart resize automatically
                maintainAspectRatio: false, // ✅ Allows full width stretch inside the container
                scales: {
                    y: {
                        beginAtZero: true,
                        title: { display: true, text: 'Deliveries' }
                    },
                    x: {
                        title: { display: true, text: 'Time Range' }
                    }
                }
            }
        });


        // 🔄 Handle dropdown change
        document.getElementById('chartRange').addEventListener('change', function () {
            let selected = this.value;
            if (selected === 'daily') currentDataset = dailyData;
            else if (selected === 'weekly') currentDataset = weeklyData;
            else currentDataset = monthlyData;

            chart.data.labels = currentDataset.labels;
            chart.data.datasets[0].data = currentDataset.data;
            chart.update();
        });
    </script>
}
