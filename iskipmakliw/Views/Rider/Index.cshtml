                                    {
                                        int id = 1;
                                        foreach (var data in Model.Where(u => !u.isRemitted))
                                        {
                                            if (data == null)
                                            {

                                            }
                                            var purchased = data.PurchasedProduct;
                                            var hasVariant = purchased?.ProductVariants != null;
                                            var seller = hasVariant
                                            ? purchased.ProductVariants.Product.Users.Username
                                            : purchased?.CustomizationOrders?.Sellers?.Username;

                                            var itemName = hasVariant
                                            ? purchased.ProductVariants.Product.Name
                                            : "Customized from " + (purchased?.CustomizationOrders?.Sellers?.Username ?? "Unknown");

                                            <tr>
                                                <th scope="row">@id</th>
                                                <td>@seller</td>
                                                <td>@itemName</td>
                                                <td>@purchased?.Quantity</td>
                                                <td>@(purchased?.Price != null ? Convert.ToDecimal(purchased.Price).ToString("N2") : "0.00")</td>
                                            </tr>

                                            id++;
                                        }
                                        <tr>
                                            <td colspan="5" class="text-center text-muted">No remittance available</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center text-muted">No products available</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <button id="Remit" class="btn btn-info btn-sm w-75">Remit all</button>
                    </div>

                </div>
            </div>
