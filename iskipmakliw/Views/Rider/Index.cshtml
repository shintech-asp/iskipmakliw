@{
    Layout = "_LayoutRider";
    var user = ViewBag.Status as iskipmakliw.Models.Users; // optional cast
}
@model List<DeliverProduct>;
@if (user.UserDetails.Status == "Pending")
{
    <div class="alert alert-warning mt-5">
        <p>Please wait for the admins approval. Thank you!</p>
    </div>
}
else if(user.UserDetails.Status == "Declined")
{
    <div class="alert alert-danger mt-5">
        <p>Sorry, your application has been declined. Reason: @user.UserDetails.DeclinedReason.</p>
    </div>
}
else
{
    <div class="row layout-top-spacing">
        <div class="col-xl-4 col-lg-12 col-md-12 col-sm-12 col-12 layout-spacing">
            <div class="widget widget-six">
                <div class="widget-heading">
                    <h6 class="">Today Statistics</h6>
                    <div class="task-action">
                        <div class="dropdown">
                            <a class="dropdown-toggle" href="#" role="button" id="statistics" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
