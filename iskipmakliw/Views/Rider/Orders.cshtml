@{
    ViewData["Title"] = "Available Deliveries";
    Layout = "_LayoutRider";
}
@model List<DeliverProduct>

<div class="layout-px-spacing">

    <!-- Header -->
    <div class="page-header">
        <div class="page-title">
            <h3>Available Deliveries</h3>
        </div>
    </div>

    <!-- Deliveries Grid -->
    <div class="row layout-top-spacing">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-xl-4 col-lg-6 col-md-6 col-sm-12 mb-4">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="card-title mb-0">@item.PurchasedProduct.ProductVariants.Material - @item.PurchasedProduct.ProductVariants.Product.Name</h5>
                                <span class="badge bg-info">@item.Status</span>
                            </div>

                            <p class="text-muted mb-2">
                                <strong>Pickup:</strong> @item.PurchasedProduct.ProductVariants.Product.Users.UserDetails.Address <br />
                                <strong>Drop-off:</strong> @item.PurchasedProduct.Billings.Address
                            </p>

                            <p class="text-muted mb-3">
                                <strong>Customer:</strong> @item.PurchasedProduct.Billings.Name <br />
                                <strong>Contact:</strong> @item.PurchasedProduct.Billings.ContactNumber
                            </p>

                            <div class="d-flex justify-content-between mt-auto">
                                <span class="fw-bold text-success fs-6">₱@item.PurchasedProduct.Price</span>
                                <a class="btn btn-primary btn-sm accept-btn"
                                asp-controller="Rider"
                                asp-action="OrderView"
                                asp-route-id="@item.Id">
                                    <i class="fas fa-check-circle me-1"></i> View
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center mt-5">
                <img src="~/src//assets/img/sad-face-2691.png" alt="No deliveries" class="mb-3" width="180" />
                <h5>No available deliveries right now</h5>
                <p class="text-muted">Check back soon for new delivery requests.</p>
            </div>
        }
    </div>
</div>