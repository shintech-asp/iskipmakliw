                                        <button type="submit" class="btn btn-primary">Submit</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </form>
            </div>

            <!-- Map Section -->
            <div class="col-xl-8 col-lg-7 col-md-12 mt-3">
