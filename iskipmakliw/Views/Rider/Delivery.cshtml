@{
    Layout = "_LayoutRider";
}

@model DeliverProduct
@if (Model != null)
{
    @if (Model.PurchasedProduct.ProductVariantsId != null)
    {
        <div class="row mt-4">
            <!-- Order Info -->
            <div class="col-xl-4 col-lg-5 col-md-12 mt-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">Order Information</h5>
                        <ul class="list-unstyled mb-0">
                            <li><strong>Order ID:</strong> @Model.Id</li>
                            <li><strong>Customer:</strong> @Model.PurchasedProduct?.Billings?.Name</li>
                            <li><strong>Product:</strong> @Model.PurchasedProduct?.ProductVariants?.Material - @Model.PurchasedProduct?.ProductVariants?.Product?.Name</li>
                            <li><strong>Price:</strong> ₱@Model.PurchasedProduct?.Price</li>
                            <li><strong>Status:</strong> <span class="badge bg-primary">@Model.Status</span></li>
                        </ul>
                    </div>
                </div>

                <div class="card shadow-sm border-0 mt-3">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">Location Details</h5>
                        <p class="mb-2"><strong>Pickup Address:</strong><br>@Model.PurchasedProduct.ProductVariants.Product.Users.UserDetails.Address</p>
                        <p class="mb-2"><strong>Drop-off Address:</strong><br>@Model.PurchasedProduct.Billings.Address</p>
                        <p class="mb-2"><strong>Distance:</strong> <span id="distance">Calculating...</span></p>

                        <!-- ETA Display -->
                        <div id="etaContainer" style="display:none;">
                            <hr>
                            <p class="mb-2" id="etaText" style="color: #0066cc; font-weight: bold;">
                                ETA: <span id="estimatedTime">--</span>
                            </p>
                            <small id="etaStatus" class="text-muted"></small>
                        </div>
                    </div>
                </div>
                @{
                    // Ensure it's parsed as DateTime before formatting
                    DateTime acceptedOn = Convert.ToDateTime(Model.AcceptedOn);
                    string acceptedOnIso = acceptedOn.ToString("yyyy-MM-ddTHH:mm:ss"); // ISO format for JS
                }
                <div class="alert alert-info text-center">
                    <b>Time lapsed:</b><br />
                    <span id="timeLapsed">Calculating...</span>
                </div>
                <form asp-action="Delivery" asp-controller="Rider" asp-route-Id="@Model.Id" enctype="multipart/form-data">
                    >
                    @if (Model.PickUpOn == null)
                    {
                        <button type="submit" class="mt-3 btn btn-warning w-100">
                            Item received
                        </button>
                        <input type="hidden" name="Type" value="1" />
                    }
                    else if (Model.PickUpOn != null && Model.DropOffOn == null)
                    {
                        <button type="submit" class="mt-3 btn btn-secondary w-100">
                            Item drop
                        </button>
                        <input type="hidden" name="Type" value="2" />
                    }
                    else if (Model.PickUpOn != null && Model.DropOffOn != null)
                    {
                        <button type="button" id="deliverBtn" class="mt-3 btn btn-success w-100">
                            Delivered
                        </button>
                        <input type="hidden" name="Type" value="3" />
                        <div class="modal fade modal-notification" id="standardModal" tabindex="-1" aria-labelledby="standardModalLabel" aria-hidden="true">
                            <div class="modal-dialog" role="document" id="standardModalLabel">
                                <div class="modal-content">
                                    <div class="modal-body text-center">
                                        <div class="icon-content mb-3">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-smile"><circle cx="12" cy="12" r="10"></circle><path d="M8 14s1.5 2 4 2 4-2 4-2"></path><line x1="9" y1="9" x2="9.01" y2="9"></line><line x1="15" y1="9" x2="15.01" y2="9"></line></svg>
                                        </div>

                                        <p class="modal-text mb-3 text-center">Submit image capture</p>

                                        <div class="profile-image" hidden>

                                            <div class="img-uploader-content">
                                                <input type="file" class="filepond"
                                                       name="ImageFile" accept="image/png, image/jpeg, image/gif" />
                                            </div>

                                        </div>
                                        <div class="multiple-file-upload mt-5">
                                            <input type="file"
                                                   class="filepond file-upload-multiple"
                                                   name="ImageFile"
                                                   data-allow-reorder="true"
                                                   data-max-file-size="3MB"
                                                   data-max-files="1"
                                                   id="Image"
                                                   required>
                                        </div>
                                    </div>

                                    <div class="modal-footer justify-content-between">
                                        <button type="button" class="btn btn-light-dark" data-bs-dismiss="modal">Discard</button>
                                        <button type="submit" class="btn btn-primary">Submit</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </form>
            </div>

            <!-- Map Section -->
            <div class="col-xl-8 col-lg-7 col-md-12 mt-3">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0">Delivery Route</h5>
                    </div>
                    <div class="card-body p-3">
                        <div id="order-map" style="height: 500px; width: 100%; border-radius: 0 0 8px 8px;"></div>
                    </div>
                </div>
            </div>
        </div>

        @section Scripts {
            <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
            <script src="https://unpkg.com/leaflet-routing-machine/dist/leaflet-routing-machine.js"></script>

            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    $("#deliverBtn").on("click", function(){
                        $("#standardModal").modal("show")
                    })
                    FilePond.setOptions({
                        server: null,
                        instantUpload: false,
                        allowMultiple: false,
                        maxFiles: 1
                    });

                    const Image = FilePond.create(document.getElementById('Image'), {
                        name: 'ImageFile',
                        storeAsFile: true
                    });
                    const form = document.querySelector('form');
                        form.addEventListener('submit', function(e) {
                            const ImageFile = Image.getFiles();

                            console.log('ImageFile:', ImageFile);

                    });
                    // ✅ Location data
                    const dropoffLat = @Model.PurchasedProduct.Billings.Latitude;
                    const dropoffLng = @Model.PurchasedProduct.Billings.Longitude;
                    const pickupLat = @Model.PurchasedProduct.ProductVariants.Product.Users.UserDetails.Latitude;
                    const pickupLng = @Model.PurchasedProduct.ProductVariants.Product.Users.UserDetails.Longitude;

                    // ✅ Track delivery state
                    const hasPickup = @((Model.PickUpOn != null).ToString().ToLower());
                    const hasDropoff = @((Model.DropOffOn != null).ToString().ToLower());
                    const deliveryId = @Model.Id;

                    // ✅ Initialize Leaflet map
                    const map = L.map('order-map').setView([pickupLat, pickupLng], 13);
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        maxZoom: 19,
                        attribution: '&copy; OpenStreetMap contributors'
                    }).addTo(map);

                    // ✅ Pickup marker
                    const pickupMarker = L.marker([pickupLat, pickupLng], {
                        icon: L.icon({
                            iconUrl: 'https://cdn-icons-png.flaticon.com/512/149/149059.png',
                            iconSize: [32, 32],
                            iconAnchor: [16, 32]
                        })
                    }).addTo(map).bindPopup("<b>Pickup Location</b><br>@Model.PurchasedProduct.ProductVariants.Product.Users.UserDetails.Address");

                    // ✅ Dropoff marker
                    const dropoffMarker = L.marker([dropoffLat, dropoffLng], {
                        icon: L.icon({
                            iconUrl: 'https://cdn-icons-png.flaticon.com/512/684/684908.png',
                            iconSize: [32, 32],
                            iconAnchor: [16, 32]
                        })
                    }).addTo(map).bindPopup("<b>Drop-off Location</b><br>@Model.PurchasedProduct.Billings.Address");

                    // ✅ Driver marker setup
                    const driverIcon = L.icon({
                        iconUrl: 'https://cdn-icons-png.flaticon.com/512/3097/3097161.png',
                        iconSize: [40, 40],
                        iconAnchor: [20, 40]
                    });

                    let driverMarker = null;
                    let routingControl = null;
                    let routeDistance = 0; // Store route distance in meters
                    let routeDuration = 0; // Store route duration in seconds

                    // ✅ Route drawer with ETA calculation
                    function drawRoute(fromLat, fromLng, toLat, toLng) {
                        if (routingControl) map.removeControl(routingControl);

                        routingControl = L.Routing.control({
                            waypoints: [L.latLng(fromLat, fromLng), L.latLng(toLat, toLng)],
                            lineOptions: { styles: [{ color: '#007bff', weight: 5, opacity: 0.8 }] },
                            addWaypoints: false,
                            draggableWaypoints: false,
                            fitSelectedRoutes: true,
                            createMarker: () => null,
                            show: false,
                            router: L.Routing.osrmv1({ serviceUrl: 'https://router.project-osrm.org/route/v1' })
                        }).addTo(map);

                        routingControl.on('routeselected', () => {
                            const panel = document.querySelector('.leaflet-routing-container');
                            if (panel) panel.style.display = 'none';
                        });

                        routingControl.on('routesfound', e => {
                            const route = e.routes[0];
                            routeDistance = route.summary.totalDistance; // in meters
                            routeDuration = route.summary.totalTime; // in seconds
                            const distKm = (routeDistance / 1000).toFixed(2);
                            document.getElementById("distance").textContent = `${distKm} km (by road)`;

                            console.log('Route found - Distance:', distKm, 'km, Duration:', routeDuration, 'seconds');
                        });
                    }

                    // ✅ Calculate ETA based on current position and route
                    function calculateETA(riderLat, riderLng, destination) {
                        if (routeDistance === 0 || routeDuration === 0) return null;

                        // Calculate remaining distance using haversine formula
                        const toRad = (deg) => (deg * Math.PI) / 180;
                        const R = 6371000; // Earth's radius in meters

                        const dLat = toRad(destination.lat - riderLat);
                        const dLng = toRad(destination.lng - riderLng);
                        const a =
                            Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                            Math.cos(toRad(riderLat)) * Math.cos(toRad(destination.lat)) *
                            Math.sin(dLng / 2) * Math.sin(dLng / 2);
                        const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
                        const remainingDistance = R * c; // in meters

                        // Estimate ETA: remaining distance / average speed
                        // Average speed from route: distance / duration
                        const avgSpeed = routeDistance / routeDuration; // meters per second
                        const etaSeconds = remainingDistance / avgSpeed;

                        return {
                            etaSeconds: Math.max(0, etaSeconds),
                            remainingDistance: remainingDistance
                        };
                    }

                    // ✅ Format ETA display
                    function formatETATime(seconds) {
                        const minutes = Math.floor(seconds / 60);
                        const secs = Math.floor(seconds % 60);

                        if (minutes === 0) {
                            return `${secs}s`;
                        } else if (minutes < 60) {
                            return `${minutes}m ${secs}s`;
                        } else {
                            const hours = Math.floor(minutes / 60);
                            const mins = minutes % 60;
                            return `${hours}h ${mins}m`;
                        }
                    }

                    // ✅ Update ETA display
                    function updateETADisplay(riderLat, riderLng) {
                        const etaContainer = document.getElementById('etaContainer');
                        const estimatedTimeEl = document.getElementById('estimatedTime');
                        const etaStatusEl = document.getElementById('etaStatus');

                        if (!hasPickup) {
                            // Going to pickup
                            const eta = calculateETA(riderLat, riderLng, { lat: pickupLat, lng: pickupLng });
                            if (eta) {
                                etaContainer.style.display = 'block';
                                estimatedTimeEl.textContent = formatETATime(eta.etaSeconds);
                                estimatedTimeEl.style.color = eta.etaSeconds < 300 ? '#28a745' : '#0066cc'; // Green if < 5 min
                                etaStatusEl.textContent = '📍 ETA to pickup location';
                            }
                        } else if (hasPickup && !hasDropoff) {
                            // Going to dropoff
                            const eta = calculateETA(riderLat, riderLng, { lat: dropoffLat, lng: dropoffLng });
                            if (eta) {
                                etaContainer.style.display = 'block';
                                estimatedTimeEl.textContent = formatETATime(eta.etaSeconds);
                                estimatedTimeEl.style.color = eta.etaSeconds < 300 ? '#28a745' : '#0066cc'; // Green if < 5 min
                                etaStatusEl.textContent = '🎯 ETA to drop-off location';
                            }
                        } else {
                            // Delivery complete
                            etaContainer.style.display = 'none';
                        }
                    }

                    // ✅ Geolocation tracking
                    if (navigator.geolocation) {
                        navigator.geolocation.watchPosition(
                            pos => {
                                const lat = pos.coords.latitude;
                                const lng = pos.coords.longitude;

                                // Update driver marker
                                if (!driverMarker) {
                                    driverMarker = L.marker([lat, lng], { icon: driverIcon }).addTo(map)
                                        .bindPopup("<b>🏍️ Your Location</b>");
                                    map.setView([lat, lng], 15);
                                } else {
                                    driverMarker.setLatLng([lat, lng]);
                                }

                                // ✅ Update database with driver's position
                                fetch('/Rider/UpdateDriversPosition', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({
                                        Id: deliveryId,
                                        Lat: lat.toString(),
                                        Long: lng.toString()
                                    })
                                }).then(res => res.json())
                                  .then(data => console.log("Position updated:", data))
                                  .catch(err => console.error("Error updating position:", err));

                                // ✅ Determine which route to display
                                if (!hasPickup) {
                                    drawRoute(lat, lng, pickupLat, pickupLng); // before pickup
                                } else if (hasPickup && !hasDropoff) {
                                    drawRoute(lat, lng, dropoffLat, dropoffLng); // after pickup
                                } else {
                                    drawRoute(pickupLat, pickupLng, dropoffLat, dropoffLng); // completed
                                }

                                // ✅ Update ETA based on current position
                                updateETADisplay(lat, lng);
                            },
                            err => console.error("Geolocation error:", err),
                            { enableHighAccuracy: true, maximumAge: 5000, timeout: 10000 }
                        );
                    } else {
                        alert("Geolocation not supported by your browser.");
                    }

                    setTimeout(() => map.invalidateSize(), 800);
                });

                // ✅ Time-lapse updater
                const acceptedOn = new Date("@acceptedOnIso");
                function updateTimeLapsed() {
                    const diff = new Date() - acceptedOn;
                    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                    const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
                    const minutes = Math.floor((diff / (1000 * 60)) % 60);
                    const seconds = Math.floor((diff / 1000) % 60);

                    document.getElementById("timeLapsed").textContent =
                        (days > 0 ? `${days}d ` : "") +
                        (hours > 0 ? `${hours}h ` : "") +
                        (minutes > 0 ? `${minutes}m ` : "") +
                        `${seconds}s`;
                }

                setInterval(updateTimeLapsed, 1000);
                updateTimeLapsed();
            </script>
        }
    }
    else
    {
        <div class="row mt-4">
            <!-- Order Info -->
            <div class="col-xl-4 col-lg-5 col-md-12 mt-3">
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">Order Information</h5>
                        <ul class="list-unstyled mb-0">
                            <li><strong>Order ID:</strong> @Model.Id</li>
                            <li><strong>Customer:</strong> @Model.PurchasedProduct?.Billings?.Name</li>
                            <li><strong>Product:</strong> Customization OrderId #1000@(Model.PurchasedProduct.CustomizationOrdersId)</li>
                            <li><strong>Price:</strong> ₱@Model.PurchasedProduct?.Price</li>
                            <li><strong>Status:</strong> <span class="badge bg-primary">@Model.Status</span></li>
                        </ul>
                    </div>
                </div>

                <div class="card shadow-sm border-0 mt-3">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">Location Details</h5>
                        <p class="mb-2"><strong>Pickup Address:</strong><br>@Model.PurchasedProduct.CustomizationOrders.Sellers.UserDetails.Address</p>
                        <p class="mb-2"><strong>Drop-off Address:</strong><br>@Model.PurchasedProduct.Billings.Address</p>
                        <p class="mb-2"><strong>Distance:</strong> <span id="distance">Calculating...</span></p>

                        <!-- ETA Display -->
                        <div id="etaContainer" style="display:none;">
                            <hr>
                            <p class="mb-2" id="etaText" style="color: #0066cc; font-weight: bold;">
                                ETA: <span id="estimatedTime">--</span>
                            </p>
                            <small id="etaStatus" class="text-muted"></small>
                        </div>
                    </div>
                </div>
                @{
                    // Ensure it's parsed as DateTime before formatting
                    DateTime acceptedOn = Convert.ToDateTime(Model.AcceptedOn);
                    string acceptedOnIso = acceptedOn.ToString("yyyy-MM-ddTHH:mm:ss"); // ISO format for JS
                }
                <div class="alert alert-info text-center">
                    <b>Time lapsed:</b><br />
                    <span id="timeLapsed">Calculating...</span>
                </div>
                <form asp-action="Delivery" asp-controller="Rider" asp-route-Id="@Model.Id" enctype="multipart/form-data">
                    @if (Model.PickUpOn == null)
                    {
                        <button type="submit" class="mt-3 btn btn-warning w-100">
                            Item received
                        </button>
                        <input type="hidden" name="Type" value="1" />
                    }
                    else if (Model.PickUpOn != null && Model.DropOffOn == null)
                    {
                        <button type="submit" class="mt-3 btn btn-secondary w-100">
                            Item drop
                        </button>
                        <input type="hidden" name="Type" value="2" />
                    }
                    else if (Model.PickUpOn != null && Model.DropOffOn != null)
                    {
                        <button type="button" id="deliverBtn" class="mt-3 btn btn-success w-100">
                            Delivered
                        </button>
                        <input type="hidden" name="Type" value="3" />
                        <div class="modal fade modal-notification" id="standardModal" tabindex="-1" aria-labelledby="standardModalLabel" aria-hidden="true">
                            <div class="modal-dialog" role="document" id="standardModalLabel">
                                <div class="modal-content">
                                    <div class="modal-body text-center">
                                        <div class="icon-content mb-3">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-smile"><circle cx="12" cy="12" r="10"></circle><path d="M8 14s1.5 2 4 2 4-2 4-2"></path><line x1="9" y1="9" x2="9.01" y2="9"></line><line x1="15" y1="9" x2="15.01" y2="9"></line></svg>
                                        </div>

                                        <p class="modal-text mb-3 text-center">Submit image capture</p>

                                        <div class="profile-image" hidden>

                                            <div class="img-uploader-content">
                                                <input type="file" class="filepond"
                                                       name="ImageFile" accept="image/png, image/jpeg, image/gif" />
                                            </div>

                                        </div>
                                        <div class="multiple-file-upload mt-5">
                                            <input type="file"
                                                   class="filepond file-upload-multiple"
                                                   name="ImageFile"
                                                   data-allow-reorder="true"
                                                   data-max-file-size="3MB"
                                                   data-max-files="1"
                                                   id="Image"
                                                   required>
                                        </div>
                                    </div>

                                    <div class="modal-footer justify-content-between">
                                        <button type="button" class="btn btn-light-dark" data-bs-dismiss="modal">Discard</button>
                                        <button type="submit" class="btn btn-primary">Submit</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </form>
            </div>

            <!-- Map Section -->
            <div class="col-xl-8 col-lg-7 col-md-12 mt-3">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
                        <h5 class="fw-bold mb-0">Delivery Route</h5>
                    </div>
                    <div class="card-body p-3">
                        <div id="order-map" style="height: 500px; width: 100%; border-radius: 0 0 8px 8px;"></div>
                    </div>
                </div>
            </div>
        </div>

        @section Scripts {
            <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
            <script src="https://unpkg.com/leaflet-routing-machine/dist/leaflet-routing-machine.js"></script>

            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    // ✅ Location data
                    $("#deliverBtn").on("click", function(){
                        $("#standardModal").modal("show")
                    })
                    FilePond.setOptions({
                        server: null,
                        instantUpload: false,
                        allowMultiple: false,
                        maxFiles: 1
                    });

                    const Image = FilePond.create(document.getElementById('Image'), {
                        name: 'ImageFile',
                        storeAsFile: true
                    });
                    const form = document.querySelector('form');
                        form.addEventListener('submit', function(e) {
                            const ImageFile = Image.getFiles();

                            console.log('ImageFile:', ImageFile);

                    });
                    const dropoffLat = @Model.PurchasedProduct.Billings.Latitude;
                    const dropoffLng = @Model.PurchasedProduct.Billings.Longitude;
                    const pickupLat = @Model.PurchasedProduct.CustomizationOrders.Sellers.UserDetails.Latitude;
                    const pickupLng = @Model.PurchasedProduct.CustomizationOrders.Sellers.UserDetails.Longitude;

                    // ✅ Track delivery state
                    const hasPickup = @((Model.PickUpOn != null).ToString().ToLower());
                    const hasDropoff = @((Model.DropOffOn != null).ToString().ToLower());
                    const deliveryId = @Model.Id;

                    // ✅ Initialize Leaflet map
                    const map = L.map('order-map').setView([pickupLat, pickupLng], 13);
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        maxZoom: 19,
                        attribution: '&copy; OpenStreetMap contributors'
                    }).addTo(map);

                    // ✅ Pickup marker
                    const pickupMarker = L.marker([pickupLat, pickupLng], {
                        icon: L.icon({
                            iconUrl: 'https://cdn-icons-png.flaticon.com/512/149/149059.png',
                            iconSize: [32, 32],
                            iconAnchor: [16, 32]
                        })
                    }).addTo(map).bindPopup("<b>Pickup Location</b><br>@Model.PurchasedProduct.CustomizationOrders.Sellers.UserDetails.Address");

                    // ✅ Dropoff marker
                    const dropoffMarker = L.marker([dropoffLat, dropoffLng], {
                        icon: L.icon({
                            iconUrl: 'https://cdn-icons-png.flaticon.com/512/684/684908.png',
                            iconSize: [32, 32],
                            iconAnchor: [16, 32]
                        })
                    }).addTo(map).bindPopup("<b>Drop-off Location</b><br>@Model.PurchasedProduct.Billings.Address");

                    // ✅ Driver marker setup
                    const driverIcon = L.icon({
                        iconUrl: 'https://cdn-icons-png.flaticon.com/512/3097/3097161.png',
                        iconSize: [40, 40],
                        iconAnchor: [20, 40]
                    });

                    let driverMarker = null;
                    let routingControl = null;
                    let routeDistance = 0; // Store route distance in meters
                    let routeDuration = 0; // Store route duration in seconds

                    // ✅ Route drawer with ETA calculation
                    function drawRoute(fromLat, fromLng, toLat, toLng) {
                        if (routingControl) map.removeControl(routingControl);

                        routingControl = L.Routing.control({
                            waypoints: [L.latLng(fromLat, fromLng), L.latLng(toLat, toLng)],
                            lineOptions: { styles: [{ color: '#007bff', weight: 5, opacity: 0.8 }] },
                            addWaypoints: false,
                            draggableWaypoints: false,
                            fitSelectedRoutes: true,
                            createMarker: () => null,
                            show: false,
                            router: L.Routing.osrmv1({ serviceUrl: 'https://router.project-osrm.org/route/v1' })
                        }).addTo(map);

                        routingControl.on('routeselected', () => {
                            const panel = document.querySelector('.leaflet-routing-container');
                            if (panel) panel.style.display = 'none';
                        });

                        routingControl.on('routesfound', e => {
                            const route = e.routes[0];
                            routeDistance = route.summary.totalDistance; // in meters
                            routeDuration = route.summary.totalTime; // in seconds
                            const distKm = (routeDistance / 1000).toFixed(2);
                            document.getElementById("distance").textContent = `${distKm} km (by road)`;

                            console.log('Route found - Distance:', distKm, 'km, Duration:', routeDuration, 'seconds');
                        });
                    }

                    // ✅ Calculate ETA based on current position and route
                    function calculateETA(riderLat, riderLng, destination) {
                        if (routeDistance === 0 || routeDuration === 0) return null;

                        // Calculate remaining distance using haversine formula
                        const toRad = (deg) => (deg * Math.PI) / 180;
                        const R = 6371000; // Earth's radius in meters

                        const dLat = toRad(destination.lat - riderLat);
                        const dLng = toRad(destination.lng - riderLng);
                        const a =
                            Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                            Math.cos(toRad(riderLat)) * Math.cos(toRad(destination.lat)) *
                            Math.sin(dLng / 2) * Math.sin(dLng / 2);
                        const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
                        const remainingDistance = R * c; // in meters

                        // Estimate ETA: remaining distance / average speed
                        // Average speed from route: distance / duration
                        const avgSpeed = routeDistance / routeDuration; // meters per second
                        const etaSeconds = remainingDistance / avgSpeed;

                        return {
                            etaSeconds: Math.max(0, etaSeconds),
                            remainingDistance: remainingDistance
                        };
                    }

                    // ✅ Format ETA display
                    function formatETATime(seconds) {
                        const minutes = Math.floor(seconds / 60);
                        const secs = Math.floor(seconds % 60);

                        if (minutes === 0) {
                            return `${secs}s`;
                        } else if (minutes < 60) {
                            return `${minutes}m ${secs}s`;
                        } else {
                            const hours = Math.floor(minutes / 60);
                            const mins = minutes % 60;
                            return `${hours}h ${mins}m`;
                        }
                    }

                    // ✅ Update ETA display
                    function updateETADisplay(riderLat, riderLng) {
                        const etaContainer = document.getElementById('etaContainer');
                        const estimatedTimeEl = document.getElementById('estimatedTime');
                        const etaStatusEl = document.getElementById('etaStatus');

                        if (!hasPickup) {
                            // Going to pickup
                            const eta = calculateETA(riderLat, riderLng, { lat: pickupLat, lng: pickupLng });
                            if (eta) {
                                etaContainer.style.display = 'block';
                                estimatedTimeEl.textContent = formatETATime(eta.etaSeconds);
                                estimatedTimeEl.style.color = eta.etaSeconds < 300 ? '#28a745' : '#0066cc'; // Green if < 5 min
                                etaStatusEl.textContent = '📍 ETA to pickup location';
                            }
                        } else if (hasPickup && !hasDropoff) {
                            // Going to dropoff
                            const eta = calculateETA(riderLat, riderLng, { lat: dropoffLat, lng: dropoffLng });
                            if (eta) {
                                etaContainer.style.display = 'block';
                                estimatedTimeEl.textContent = formatETATime(eta.etaSeconds);
                                estimatedTimeEl.style.color = eta.etaSeconds < 300 ? '#28a745' : '#0066cc'; // Green if < 5 min
                                etaStatusEl.textContent = '🎯 ETA to drop-off location';
                            }
                        } else {
                            // Delivery complete
                            etaContainer.style.display = 'none';
                        }
                    }

                    // ✅ Geolocation tracking
                    if (navigator.geolocation) {
                        navigator.geolocation.watchPosition(
                            pos => {
                                const lat = pos.coords.latitude;
                                const lng = pos.coords.longitude;

                                // Update driver marker
                                if (!driverMarker) {
                                    driverMarker = L.marker([lat, lng], { icon: driverIcon }).addTo(map)
                                        .bindPopup("<b>🏍️ Your Location</b>");
                                    map.setView([lat, lng], 15);
                                } else {
                                    driverMarker.setLatLng([lat, lng]);
                                }

                                // ✅ Update database with driver's position
                                fetch('/Rider/UpdateDriversPosition', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({
                                        Id: deliveryId,
                                        Lat: lat.toString(),
                                        Long: lng.toString()
                                    })
                                }).then(res => res.json())
                                  .then(data => console.log("Position updated:", data))
                                  .catch(err => console.error("Error updating position:", err));

                                // ✅ Determine which route to display
                                if (!hasPickup) {
                                    drawRoute(lat, lng, pickupLat, pickupLng); // before pickup
                                } else if (hasPickup && !hasDropoff) {
                                    drawRoute(lat, lng, dropoffLat, dropoffLng); // after pickup
                                } else {
                                    drawRoute(pickupLat, pickupLng, dropoffLat, dropoffLng); // completed
                                }

                                // ✅ Update ETA based on current position
                                updateETADisplay(lat, lng);
                            },
                            err => console.error("Geolocation error:", err),
                            { enableHighAccuracy: true, maximumAge: 5000, timeout: 10000 }
                        );
                    } else {
                        alert("Geolocation not supported by your browser.");
                    }

                    setTimeout(() => map.invalidateSize(), 800);
                });

                // ✅ Time-lapse updater
                const acceptedOn = new Date("@acceptedOnIso");
                function updateTimeLapsed() {
                    const diff = new Date() - acceptedOn;
                    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
                    const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
                    const minutes = Math.floor((diff / (1000 * 60)) % 60);
                    const seconds = Math.floor((diff / 1000) % 60);

                    document.getElementById("timeLapsed").textContent =
                        (days > 0 ? `${days}d ` : "") +
                        (hours > 0 ? `${hours}h ` : "") +
                        (minutes > 0 ? `${minutes}m ` : "") +
                        `${seconds}s`;
                }

                setInterval(updateTimeLapsed, 1000);
                updateTimeLapsed();
            </script>
        }
    }

}
else
{
    <div class="text-center mt-5">
        <img src="~/src//assets/img/sad-face-2691.png" alt="No deliveries" class="mb-3" width="180" />
        <h5>No available deliveries right now</h5>
        <p class="text-muted">Check back soon for new delivery requests.</p>
    </div>
}
