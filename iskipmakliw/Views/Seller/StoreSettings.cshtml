@{
    ViewData["Title"] = "3D Model Generator";
    Layout = "_LayoutSeller";
}

<style>
    /* Cork UI Professional Styling */
    .layout-spacing {
        margin-bottom: 25px;
    }

    .upload-zone {
        border: 2px dashed #e0e6ed;
        border-radius: 8px;
        padding: 40px 20px;
        text-center;
        cursor: pointer;
        transition: all 0.3s;
        background: #fafafa;
    }

        .upload-zone:hover {
            border-color: #4361ee;
            background: #f8f9ff;
        }

    .mode-btn {
        padding: 10px 24px;
        border: none;
        background: #fff;
        color: #888ea8;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s;
    }

        .mode-btn.active {
            background: #4361ee;
            color: #fff;
        }

    .preview-strip {
        display: flex;
        gap: 12px;
        margin-top: 20px;
        flex-wrap: wrap;
    }

    .preview-thumb {
        position: relative;
        width: 110px;
        height: 110px;
        border-radius: 8px;
        overflow: hidden;
        border: 2px solid #e0e6ed;
    }

        .preview-thumb img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .preview-thumb .remove-btn {
            position: absolute;
            top: 4px;
            right: 4px;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: rgba(231, 81, 90, 0.95);
            color: #fff;
            border: none;
            cursor: pointer;
        }

    .resume-banner {
        background: linear-gradient(135deg, #fff4e6 0%, #ffe9c7 100%);
        border: 1px solid #ffc700;
        border-radius: 8px;
        padding: 18px 24px;
        margin-bottom: 25px;
    }

    #viewer3D {
        border-radius: 8px;
        background: linear-gradient(135deg, #f5f7fa 0%, #e9ecef 100%);
    }

    .viewer-loading {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255,0.95);
        border-radius: 8px;
        z-index: 10;
    }
</style>

<!-- Resume Banner -->
<div id="resumeBanner" class="resume-banner d-none">
    <div class="row align-items-center">
        <div class="col-auto"><i class="bi bi-hourglass-split fs-2"></i></div>
        <div class="col">
            <strong>3D Generation In Progress</strong><br>
            <small>You can leave and come back later.</small>
        </div>
        <div class="col-auto">
            <button class="btn btn-outline-danger btn-sm" id="dismissResumeBtn">
                <i class="bi bi-x-circle me-1"></i> Discard
            </button>
        </div>
    </div>
</div>

<!-- Upload Section -->
<div class="layout-spacing">
    <div class="widget">
        <div class="widget-content" style="padding:20px;">
            <h5 class="mb-4">Upload Images for 3D Conversion</h5>

            <div id="uploadSection">
                <div class="mb-4">
                    <label class="form-label fw-bold">Upload Mode</label><br>
                    <button class="mode-btn active" id="btnSingle" onclick="setMode('single')">
                        <i class="bi bi-image me-2"></i> Single
                    </button>
                    <button class="mode-btn" id="btnMulti" onclick="setMode('multi')">
                        <i class="bi bi-images me-2"></i> Multiple (2–4)
                    </button>
                </div>

                <input type="file" id="fileInput" class="d-none" accept=".jpg,.jpeg,.png,.webp">

                <div id="dropZone" class="upload-zone">
                    <i class="bi bi-cloud-arrow-up" style="font-size:3rem;color:#888ea8;"></i>
                    <h6 id="dropHint">Click or drag & drop your image</h6>
                    <small class="text-muted">JPG, PNG, WEBP • Max 10MB</small>
                </div>

                <div class="preview-strip" id="previewStrip"></div>

                <div class="mt-4 mb-4">
                    <label class="form-label fw-bold">Description (Optional)</label>
                    <textarea class="form-control" id="prompt" rows="3"></textarea>
                </div>

                <button class="btn btn-primary btn-lg w-100" id="generateBtn" onclick="generate()" disabled>
                    <i class="bi bi-magic me-2"></i> Generate 3D Model
                </button>

                <div id="progressSection" class="d-none mt-4">
                    <div class="d-flex justify-content-between mb-2">
                        <h6>Generating...</h6>
                        <span id="statusBadge" class="badge bg-secondary">PENDING</span>
                    </div>
                    <div class="progress" style="height:32px;">
                        <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated" style="width:0%">0%</div>
                    </div>
                    <p id="statusText" class="text-muted mt-2 mb-0 small">Initializing...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Saved Models -->
<div class="layout-spacing">
    <div class="widget">
        <div class="widget-content" style="padding:20px;">
            <h5 class="mb-4">Your 3D Models</h5>
            <table class="table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th style="width:280px;">Preview</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody id="tbl_models">
                    <tr>
                        <td colspan="4" class="text-center text-muted py-4">No models yet</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- 3D Preview Modal -->
<div class="modal fade" id="preview3DModal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5><i class="bi bi-box me-2"></i>3D Preview</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="viewer3D" style="width:100%; height:500px; position:relative;"></div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" id="restartBtn"><i class="bi bi-arrow-clockwise me-1"></i> Retry</button>
                <button class="btn btn-info" id="uploadNewBtn"><i class="bi bi-upload me-1"></i> Upload New</button>
                <button class="btn btn-success" id="saveModelBtn"><i class="bi bi-save me-1"></i> Save</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModelModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5><i class="bi bi-pencil me-2"></i>Edit Model</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editModelId">
                <div class="mb-3">
                    <label class="form-label fw-bold">Name</label>
                    <input type="text" class="form-control" id="editModelName">
                </div>
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="editModelActive">
                    <label class="form-check-label fw-bold">Active</label>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-light-dark" data-bs-dismiss="modal">Cancel</button>
                <button class="btn btn-primary" id="submitChangesEdit">Save Changes</button>
            </div>
        </div>
    </div>
</div>

<script type="module" src="https://unpkg.com/@@google/model-viewer/dist/model-viewer.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
<script>
    let currentMode='single',selectedFiles=[],currentTaskId=null,currentIsMulti=false,currentModelUrl=null,pollInterval=null,scene,camera,renderer,controls;
    const MAX_FILES={single:1,multi:4};

    document.addEventListener('DOMContentLoaded',function(){
    loadSavedModels();tryResumeActiveTask();
    const dz=document.getElementById('dropZone'),fi=document.getElementById('fileInput');
    dz.onclick=()=>fi.click();
    fi.onchange=function(e){addFiles(e.target.files);this.value='';};
    dz.ondragover=e=>{e.preventDefault();dz.classList.add('drag-over');};
    dz.ondragleave=e=>{e.preventDefault();dz.classList.remove('drag-over');};
    dz.ondrop=e=>{e.preventDefault();dz.classList.remove('drag-over');addFiles(e.dataTransfer.files);};

    document.getElementById('restartBtn').onclick=()=>{$('#preview3DModal').modal('hide');document.getElementById('prompt').focus();};
    document.getElementById('uploadNewBtn').onclick=()=>{$('#preview3DModal').modal('hide');clearSessionTask();clearFiles();};
    document.getElementById('saveModelBtn').onclick=saveModel;
    document.getElementById('dismissResumeBtn').onclick=()=>{
    Swal.fire({title:'Discard?',text:'Generation will be removed.',icon:'warning',showCancelButton:true,confirmButtonColor:'#e7515a',confirmButtonText:'Yes, discard'}).then(r=>{
    if(r.isConfirmed){clearSessionTask();Swal.fire({icon:'success',title:'Discarded',timer:1500,showConfirmButton:false}).then(()=>location.reload());}});};
    document.getElementById('submitChangesEdit').onclick=()=>{
    Swal.fire({title:'Save?',icon:'question',showCancelButton:true,confirmButtonColor:'#4361ee',confirmButtonText:'Save'}).then(r=>{
    if(r.isConfirmed){$.ajax({url:'@Url.Action("SubmitChangesEditModels", "Seller")',type:'POST',
    data:{editModelId:$('#editModelId').val(),editModelName:$('#editModelName').val(),editModelActive:$('#editModelActive').is(':checked')},
    success:()=>{$('#editModelModal').modal('hide');Swal.fire({icon:'success',title:'Updated',timer:1500,showConfirmButton:false}).then(()=>loadSavedModels());},
    error:()=>Swal.fire({icon:'error',title:'Error',text:'Failed to save.'})});}});};
    });

    function tryResumeActiveTask(){$.ajax({url:'@Url.Action("GetActiveTask", "Seller")',type:'GET',success:res=>{
    if(!res.hasActiveTask)return;currentTaskId=res.taskId;currentIsMulti=res.isMulti;
    document.getElementById('resumeBanner').classList.remove('d-none');
    document.getElementById('progressSection').classList.remove('d-none');
    disableAllControls();
    startPolling();}});}

    function disableAllControls(){
    const btn=document.getElementById('generateBtn');
    btn.disabled=true;
    btn.innerHTML='<span class="spinner-border spinner-border-sm me-2"></span>Generating…';
    document.getElementById('btnSingle').disabled=true;
    document.getElementById('btnMulti').disabled=true;
    document.getElementById('prompt').disabled=true;
    const dz=document.getElementById('dropZone');
    dz.style.opacity='0.5';
    dz.style.pointerEvents='none';
    dz.style.cursor='not-allowed';
    }

    function enableAllControls(){
    const btn=document.getElementById('generateBtn');
    btn.disabled=false;
    btn.innerHTML='<i class="bi bi-magic me-2"></i> Generate 3D Model';
    document.getElementById('btnSingle').disabled=false;
    document.getElementById('btnMulti').disabled=false;
    document.getElementById('prompt').disabled=false;
    const dz=document.getElementById('dropZone');
    dz.style.opacity='1';
    dz.style.pointerEvents='auto';
    dz.style.cursor='pointer';
    }

    function setMode(m){currentMode=m;
    document.getElementById('btnSingle').classList.toggle('active',m==='single');
    document.getElementById('btnMulti').classList.toggle('active',m==='multi');
    document.getElementById('dropHint').textContent=m==='single'?'Click or drag & drop your image':'Click or drag & drop 2–4 images';
    if(m==='single'&&selectedFiles.length>1){selectedFiles=[selectedFiles[0]];renderPreviews();}syncGenerateBtn();}

    function addFiles(fl){const max=MAX_FILES[currentMode],allowed=new Set(['.jpg','.jpeg','.png','.webp']),maxSize=10*1024*1024;
    for(const f of fl){if(selectedFiles.length>=max)break;
    if(f.size>maxSize){Swal.fire({icon:'error',title:'Too Large',text:`"${f.name}" is ${(f.size/1024/1024).toFixed(1)}MB. Max is 10MB.`});continue;}
    const ext='.'+f.name.split('.').pop().toLowerCase();
    if(!allowed.has(ext)){Swal.fire({icon:'error',title:'Invalid Format',text:`Use JPG, PNG or WEBP.`});continue;}
    if(selectedFiles.some(x=>x.name===f.name&&x.size===f.size))continue;
    selectedFiles.push(f);}renderPreviews();syncGenerateBtn();}

    function removeFile(i){selectedFiles.splice(i,1);renderPreviews();syncGenerateBtn();}
    function clearFiles(){selectedFiles=[];renderPreviews();syncGenerateBtn();}
    function renderPreviews(){const s=document.getElementById('previewStrip');s.innerHTML='';
    selectedFiles.forEach((f,i)=>{const r=new FileReader();r.onload=e=>{const t=document.createElement('div');t.className='preview-thumb';
    t.innerHTML=`<img src="${e.target.result}"><button class="remove-btn" onclick="removeFile(${i})">&times;</button>`;s.appendChild(t);};r.readAsDataURL(f);});
    if(currentMode==='multi'&&selectedFiles.length<4){const a=document.createElement('div');a.className='preview-thumb add-more';a.innerHTML='<span style="font-size:2rem">+</span>';
    a.onclick=()=>document.getElementById('fileInput').click();s.appendChild(a);}}
    function syncGenerateBtn(){const min=currentMode==='single'?1:2;document.getElementById('generateBtn').disabled=!(selectedFiles.length>=min&&selectedFiles.length<=MAX_FILES[currentMode]);}

    function generate(){disableAllControls();
    document.getElementById('progressSection').classList.remove('d-none');
    const fd=new FormData();selectedFiles.forEach(f=>fd.append('imageFiles',f));fd.append('mode',currentMode);
    $.ajax({url:'@Url.Action("UploadImage", "Seller")',type:'POST',data:fd,processData:false,contentType:false,
    success:res=>{if(res.success){currentTaskId=res.taskId;currentIsMulti=res.isMulti;
    document.getElementById('resumeBanner').classList.remove('d-none');startPolling();}else showError(res.message);},
    error:()=>showError('Upload failed.')});}

    function startPolling(){if(pollInterval)clearInterval(pollInterval);let c=0;
    pollInterval=setInterval(()=>{if(++c>120){clearInterval(pollInterval);showError('Timeout.');return;}checkStatus();},5000);}

    function checkStatus(){$.ajax({url:'@Url.Action("CheckStatus", "Seller")',type:'GET',data:{taskId:currentTaskId,isMulti:currentIsMulti},
    success:res=>{if(!res.success){clearInterval(pollInterval);showError(res.message);return;}
    $('#progressBar').css('width',res.progress+'%').text(res.progress+'%');$('#statusText').text(`Status: ${res.status} (${res.progress}%)`);
    const b=$('#statusBadge');b.text(res.status);b.removeClass('bg-secondary bg-info bg-success bg-danger');
    if(res.status==='SUCCEEDED'){b.addClass('bg-success');clearInterval(pollInterval);
    document.getElementById('resumeBanner').classList.add('d-none');enableAllControls();currentModelUrl=res.modelUrl;show3DPreview(res.modelUrl);}
    else if(res.status==='FAILED'){b.addClass('bg-danger');clearInterval(pollInterval);
    document.getElementById('resumeBanner').classList.add('d-none');enableAllControls();showError('Failed: '+(res.thumbnailUrl||'Try again.'));}
    else if(res.status==='PENDING')b.addClass('bg-secondary');else b.addClass('bg-info');},
    error:()=>{clearInterval(pollInterval);enableAllControls();showError('Status check failed.');}});}

    function proxyUrl(u){return'@Url.Action("ProxyModel", "Seller")'+'?url='+encodeURIComponent(u);}
    function show3DPreview(u){resetUI();$('#preview3DModal').modal('show');setTimeout(()=>initViewer(proxyUrl(u)),600);}

    function initViewer(url){const c=document.getElementById('viewer3D');
    c.innerHTML='<div class="viewer-loading"><div class="spinner-border text-primary" style="width:3rem;height:3rem;"></div><p class="mt-3">Loading...</p></div>';
    scene=new THREE.Scene();scene.background=new THREE.Color(0xf5f7fa);
    camera=new THREE.PerspectiveCamera(45,c.clientWidth/c.clientHeight,0.1,1000);camera.position.set(0,2,5);
    renderer=new THREE.WebGLRenderer({antialias:true});renderer.setSize(c.clientWidth,c.clientHeight);renderer.setPixelRatio(window.devicePixelRatio);c.appendChild(renderer.domElement);
    scene.add(new THREE.AmbientLight(0xffffff,0.6));const l=new THREE.DirectionalLight(0xffffff,0.8);l.position.set(5,5,5);scene.add(l);
    controls=new THREE.OrbitControls(camera,renderer.domElement);controls.enableDamping=true;
    new THREE.GLTFLoader().load(url,gltf=>{c.querySelector('.viewer-loading')?.remove();
    const m=gltf.scene,b=new THREE.Box3().setFromObject(m);m.position.sub(b.getCenter(new THREE.Vector3()));
    const s=b.getSize(new THREE.Vector3());m.scale.multiplyScalar(3/Math.max(s.x,s.y,s.z));scene.add(m);},
    xhr=>{if(xhr.lengthComputable){const p=Math.round(xhr.loaded/xhr.total*100);const t=c.querySelector('.viewer-loading p');if(t)t.textContent=`Loading ${p}%`;}},
    err=>{console.error(err);const o=c.querySelector('.viewer-loading');if(o)o.innerHTML='<i class="bi bi-exclamation-triangle text-danger fs-1"></i><p class="text-danger mt-3">Failed to load</p>';});
    (function a(){requestAnimationFrame(a);controls.update();renderer.render(scene,camera);})();
    window.addEventListener('resize',()=>{camera.aspect=c.clientWidth/c.clientHeight;camera.updateProjectionMatrix();renderer.setSize(c.clientWidth,c.clientHeight);});}

    function saveModel(){$('#preview3DModal').modal('hide');
    Swal.fire({title:'Save Model',input:'text',inputLabel:'Model Name',inputPlaceholder:'Enter name',inputValue:'Model_'+Date.now(),
    showCancelButton:true,confirmButtonText:'Save',confirmButtonColor:'#4361ee',inputValidator:v=>!v&&'Name required'}).then(r=>{
    if(r.isConfirmed){const fn='model_'+Date.now()+'_'+Math.floor(Math.random()*1000);
    Swal.fire({title:'Saving...',allowOutsideClick:false,didOpen:()=>Swal.showLoading()});
    $.ajax({url:'@Url.Action("SaveModel", "Seller")',type:'POST',data:{modelUrl:currentModelUrl,fileName:fn,modelName:r.value},
    success:res=>{Swal.close();if(res.success){Swal.fire({icon:'success',title:'Saved!',text:`"${r.value}" saved.`,timer:2000,showConfirmButton:false}).then(()=>{loadSavedModels();clearFiles();});}
    else Swal.fire({icon:'error',title:'Failed',text:res.message});},error:()=>{Swal.close();Swal.fire({icon:'error',title:'Error',text:'Save failed'});}});}});}

    function loadSavedModels(){$.ajax({url:'@Url.Action("GetSavedModels", "Seller")',type:'GET',success:res=>{
    if(!res.success||!res.data||res.data.length===0){$('#tbl_models').html('<tr><td colspan="4" class="text-center text-muted py-4">No models yet</td></tr>');return;}
    let h='';res.data.forEach(m=>{const sb=m.isActive?'<span class="badge badge-light-success">Active</span>':'<span class="badge badge-light-danger">Disabled</span>';
    h+=`<tr><td><strong>${m.modelName}</strong></td><td><model-viewer src="${m.imagePath}" camera-controls auto-rotate style="width:100%;height:180px;border-radius:8px;"></model-viewer></td>
    <td class="text-center">${sb}</td><td class="text-center"><button class="btn btn-sm btn-primary" onclick='openEditModal(${m.id},"${m.modelName.replace(/'/g,"\\'")}",${m.isActive})'>
    <i class="bi bi-pencil me-1"></i> Edit</button></td></tr>`;});$('#tbl_models').html(h);}});}

    function openEditModal(id,name,act){$('#editModelId').val(id);$('#editModelName').val(name);$('#editModelActive').prop('checked',act);$('#editModelModal').modal('show');}
    function clearSessionTask(){$.ajax({url:'@Url.Action("ClearActiveTask", "Seller")',type:'POST'});currentTaskId=null;currentModelUrl=null;}
    function resetUI(){enableAllControls();document.getElementById('progressSection').classList.add('d-none');}
    function showError(m){clearInterval(pollInterval);document.getElementById('resumeBanner').classList.add('d-none');enableAllControls();
    document.getElementById('progressSection').classList.add('d-none');Swal.fire({icon:'error',title:'Error',text:m});}
</script>
