@{
    ViewData["Title"] = "Reports";
    Layout = "_LayoutSeller";
}
@model Users
<div class="middle-content container-xxl p-0">

    <div class="row invoice layout-top-spacing layout-spacing">
        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">

            <div class="doc-container">

                <div class="row">

                    <div class="col-xl-9">

                        <div class="invoice-container">
                            <div class="invoice-inbox">

                                <div id="ct" class="">

                                    <div class="invoice-00001">
                                        <div class="content-section">

                                            <div class="inv--head-section inv--detail-section">

                                                <div class="row">

                                                    <div class="col-sm-6 col-12 mr-auto">
                                                        <div class="d-flex">
                                                            <img class="company-logo" src="~/src/assets/img/OakMartPNG.png" alt="company">
                                                            <h3 class="in-heading align-self-center">@Model.Username</h3>
                                                        </div>
                                                        <p class="inv-street-addr mt-3">@Model.UserDetails.Address</p>
                                                        <p class="inv-email-address">@Model.Email</p>
                                                        <p class="inv-email-address">@Model.ContactNumber</p>
                                                    </div>

                                                    <div class="col-sm-6 text-sm-end">
                                                        <p class="inv-created-date mt-sm-5 mt-3"><span class="inv-title">Start Date : </span> <span class="inv-date" id="startDate">-- | -- | ----</span></p>
                                                        <p class="inv-due-date"><span class="inv-title">End Date : </span> <span class="inv-date" id="endDate">-- | -- | ----</span></p>
                                                    </div>
                                                </div>

                                            </div>

                                            <div class="inv--detail-section inv--customer-detail-section">

                                                <div class="row">

                                                    <div class="col-xl-8 col-lg-7 col-md-6 col-sm-4 align-self-center">
                                                        <h5 class="inv-to">Report</h5>
                                                    </div>

                                                </div>

                                            </div>

                                            <div class="inv--product-table-section">
                                                <div class="table-responsive">
                                                    <table class="table">
                                                        <thead class="">
                                                            <tr>
                                                                <th scope="col">S.No</th>
                                                                <th scope="col">Items</th>
                                                                <th scope="col" class="text-center">Status</th>
                                                                <th class="text-end" scope="col">Qty</th>
                                                                <th class="text-end" scope="col">Total</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody id="itemTbl">
                                                            <tr>
                                                                <td colspan="4" class="fst-italic text-center">Generate your report here.</td>
                                                            </tr>
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>

                                            <div class="inv--total-amounts">

                                                <div class="row mt-4">
                                                    <div class="col-sm-5 col-12 order-sm-0 order-1">
                                                    </div>
                                                    <div class="col-sm-7 col-12 order-sm-1 order-0">
                                                        <div class="text-sm-end">
                                                            <div class="row">
                                                                <div class="col-sm-8 col-7 text-black mt-3">
                                                                    <h4 class="">Grand Total : </h4>
                                                                </div>
                                                                <div class="col-sm-4 col-5 text-black mt-3">
                                                                    <h4 class="" id="grandTotal">--</h4>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                            </div>

                                            <div class="inv--note">

                                                <div class="row mt-4">
                                                    <div class="col-sm-12 col-12 order-sm-0 order-1">
                                                        <p>Note: Thank you for doing Business with us.</p>
                                                    </div>
                                                </div>

                                            </div>

                                        </div>
                                    </div>

                                </div>


                            </div>

                        </div>

                    </div>

                    <div class="col-xl-3">

                        <div class="invoice-actions-btn">

                            <div class="invoice-action-btn">

                                <div class="row">
                                    <div class="col-12 mb-5">
                                        <label class="form-label">Report</label>
                                        <select class="form-select" id="generateReport">
                                            <option value="All">All</option>
                                            <option value="PurchasedProduct">Purchased From Store</option>
                                            <option value="Customization">Customized Order</option>
                                        </select>
                                        <label class="form-label">Status</label>
                                        <select class="form-select" id="statusReport">
                                            <option value="Completed">Completed</option>
                                            <option value="Not">Not yet complete</option>
                                        </select>
                                        <label class="form-label">Date From</label>
                                        <input type="date"
                                               class="form-control"
                                               id="dateFrom"
                                               min="@Model.DateCreated.ToString("yyyy-MM-dd")"
                                               required/>


                                        <label class="form-label">Date To</label>
                                        <input type="date" class="form-control" id="dateTo" required />

                                    </div>
                                    <div class="col-12 mt-5">
                                        <a href="javascript:void(0);" class="btn btn-secondary btn-print action-print _effect--ripple waves-effect waves-light">Print</a>
                                    </div>
                                    <div class="col-12">
                                        <button id="Generate" class="btn btn-success btn-download _effect--ripple waves-effect waves-light w-100">Generate</button>
                                    </div>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>

</div>
@section Scripts {
    <script>
        function formatDate(dateStr) {
            if (!dateStr) return "—";

            const date = new Date(dateStr);

            const day = String(date.getDate()).padStart(2, "0");
            const month = date.toLocaleString("en-US", { month: "short" });
            const year = date.getFullYear();

            return `${day} ${month} ${year}`;
        }
        const dateFrom = document.getElementById("dateFrom");
        const dateTo = document.getElementById("dateTo");
        const startDate = document.getElementById("startDate");
        const endDate = document.getElementById("endDate");

        dateFrom.addEventListener("change", function () {
            dateTo.min = this.value;

            startDate.textContent = formatDate(this.value);

            if (dateTo.value && dateTo.value < this.value) {
                dateTo.value = "";
                endDate.textContent = "—";
            }
        });

        dateTo.addEventListener("change", function () {
            endDate.textContent = formatDate(this.value);
        });
        $("#Generate").on("click", function(){
            var report = $("#generateReport").val();
            var status = $("#statusReport").val();
            var date_start = $("#dateFrom").val();
            var date_end = $("#dateTo").val();
            $.ajax({
                url:"/Seller/GenerateCompletedPurchasedProduct",
                data: {source : report, status : status, dateFrom : date_start, dateTo : date_end },
                method: "GET",
                success: function(res){
                    console.log(res.data)
                    $("#itemTbl").empty()
                    if(res.data.length > 0){
                        res.data.forEach(function (data){
                        var ids = 1;
                            $("#itemTbl").append(`
                            <tr>
                                <td>${ids}</td>
                                <td>${data.product}</td>
                                <td class="text-center">${data.paymentStatus}</td>
                                <td class="text-end">${data.quantity}</td>
                                <td class="text-end">${data.price}</td>
                            </tr>
                            `)
                            ids++;
                        })
                        $("#grandTotal").text(res.grandTotal)
                    }
                    else{
                            $("#itemTbl").append(`
                                <tr>
                                    <td colspan="4" class="fst-italic text-center">No data found</td>
                                </tr>
                            `)
                        }
                },
                error: function(xhr){
                    console.error(xhr.responseText)
                }
            })
        })
    </script>

}