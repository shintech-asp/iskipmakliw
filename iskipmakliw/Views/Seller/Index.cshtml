@using iskipmakliw.Models.ViewModels
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_LayoutSeller";
}

<style>
    .widget {
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.07);
        overflow: hidden;
    }

    .widget-heading {
        padding: 20px 24px;
        border-bottom: 1px solid #f1f2f3;
    }

        .widget-heading h5 {
            font-size: 18px;
            font-weight: 600;
            color: #1a1a1a;
            margin: 0;
        }

    .widget-content {
        padding: 24px;
    }

    .content {
        min-height: 390px;
        max-height: 390px;
        overflow-y: auto;
        padding-right: 8px;
    }

        .content::-webkit-scrollbar {
            width: 6px;
        }

        .content::-webkit-scrollbar-track {
            background: #f1f2f3;
            border-radius: 10px;
        }

        .content::-webkit-scrollbar-thumb {
            background: #cbd5e0;
            border-radius: 10px;
        }

            .content::-webkit-scrollbar-thumb:hover {
                background: #a0aec0;
            }

    .alert {
        padding: 16px 20px;
        border-radius: 10px;
        margin-bottom: 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        border: none;
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
    }

    .alert-content {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
    }

    .alert-icon {
        width: 40px;
        height: 40px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .alert-icon svg {
            width: 20px;
            height: 20px;
            stroke: white;
        }

    .alert-text {
        flex: 1;
    }

    .alert-label {
        font-size: 12px;
        color: rgba(255, 255, 255, 0.9);
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 4px;
    }

    .alert-value {
        font-size: 24px;
        font-weight: 700;
        color: white;
    }

    .content ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .content ul li {
            padding: 16px 18px;
            margin-bottom: 12px;
            background: #f8fafc;
            border-radius: 10px;
            border-left: 4px solid #3b82f6;
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

            .content ul li::before {
                content: '';
                position: absolute;
                left: 0;
                top: 0;
                width: 4px;
                height: 100%;
                background: linear-gradient(180deg, #3b82f6 0%, #2563eb 100%);
                transition: width 0.3s ease;
            }

            .content ul li:hover {
                background: #f1f5f9;
                transform: translateX(4px);
                box-shadow: 0 2px 8px rgba(59, 130, 246, 0.15);
            }

                .content ul li:hover::before {
                    width: 6px;
                }

            .content ul li:nth-child(2) {
                border-left-color: #8b5cf6;
            }

                .content ul li:nth-child(2)::before {
                    background: linear-gradient(180deg, #8b5cf6 0%, #7c3aed 100%);
                }

            .content ul li:nth-child(3) {
                border-left-color: #f59e0b;
            }

                .content ul li:nth-child(3)::before {
                    background: linear-gradient(180deg, #f59e0b 0%, #d97706 100%);
                }

            .content ul li:nth-child(4) {
                border-left-color: #ec4899;
            }

                .content ul li:nth-child(4)::before {
                    background: linear-gradient(180deg, #ec4899 0%, #db2777 100%);
                }

    .category-info {
        display: flex;
        align-items: center;
        gap: 12px;
        flex: 1;
    }

    .category-icon {
        width: 36px;
        height: 36px;
        background: white;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .category-icon svg {
            width: 18px;
            height: 18px;
        }

    .content ul li:nth-child(1) .category-icon svg {
        stroke: #3b82f6;
    }

    .content ul li:nth-child(2) .category-icon svg {
        stroke: #8b5cf6;
    }

    .content ul li:nth-child(3) .category-icon svg {
        stroke: #f59e0b;
    }

    .content ul li:nth-child(4) .category-icon svg {
        stroke: #ec4899;
    }

    .category-name {
        font-size: 14px;
        font-weight: 500;
        color: #475569;
    }

    .category-value {
        font-size: 16px;
        font-weight: 700;
        color: #1e293b;
        white-space: nowrap;
    }

    .currency {
        font-size: 13px;
        font-weight: 500;
        color: #64748b;
        margin-left: 4px;
    }

    #revenueCharts {
        position: relative;
        width: 100%;
        height: 400px; /* you can increase to 450–500px if you want it taller */
        background-color: #fff;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }

    canvas#revenueChart {
        width: 100% !important;
        height: 100% !important;
    }

</style>
@model SellersIndexViewModel;
@if (Model.Users.UserDetails?.Status == "Pending")
{
    <div class="alert alert-info my-5">
        <p>
            <strong>Please wait! </strong> Your account is currently waiting for admins approval.
        </p>
    </div>
}
else if (Model.Users.UserDetails?.Status == "Approved")
{
    @if (User.FindFirst("PaymentStatus").Value == "Pending")
    {
        <div class="alert alert-warning my-5">
            <p>
                <strong>Warning!</strong> Your account is currently pending for your payment. Please pay the amount @Model.Users.Payments.FirstOrDefault().Amount
            </p>
            <a class="btn btn-primary" asp-controller="Payments" asp-action="Checkout" asp-route-id="@Model.Users.Id">Pay now!</a>
        </div>
    }
    else
    {
        <div class="row layout-top-spacing">
        <div class="col-xl-8 col-lg-12 col-md-12 col-sm-12 col-12 layout-spacing">
                <div class="widget-content">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0">Revenue Overview</h5>
                        <select id="timeRange" class="form-select form-select-sm" style="width: 150px;">
                            <option value="monthly" selected>Monthly</option>
                            <option value="weekly">Weekly</option>
                            <option value="daily">Daily</option>
                        </select>
                    </div>

                    <div id="revenueCharts" class="p-3 bg-white rounded shadow-sm" style="height: 400px;">
                        <canvas id="revenueChart" style="width:100%; height:100%;"></canvas>
                    </div>
                </div>

        </div>

            <div class="col-xl-4 col-lg-12 col-md-12 col-sm-12 col-12 layout-spacing">
                <div class="widget widget-chart-two">
                    <div class="widget-heading">
                        <h5>Sales by Category</h5>
                    </div>
                    <div class="widget-content">
                        <div class="content">
                            <div class="alert alert-success">
                                <div class="alert-content">
                                    <div class="alert-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z" />
                                        </svg>
                                    </div>
                                    <div class="alert-text">
                                        <div class="alert-label">Total Sales</div>
                                        <div class="alert-value">@($"₱{Model.PurchasedProduct.Sum(u => u.Price):N2}")</div>
                                    </div>
                                </div>
                            </div>
                            <ul>
                                @foreach (var data in Model.PurchasedProduct.Distinct())
                                {
                                    <li>
                                        <div class="category-info">
                                            <div class="category-icon">
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round"
                                                          d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" />
                                                </svg>
                                            </div>
                                            <span class="category-name">@data.ProductVariants.Material - @data.ProductVariants.Product.Name</span><br />
                                            <p>@data.Quantity pcs</p>
                                        </div>
                                        <div class="category-value">@($"₱{data.Price:N2}")</div>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        <div class="col-xl-6 col-lg-12 col-md-12 col-sm-12 col-12 layout-spacing">
            <div class="widget widget-table-two">
    
                <div class="widget-heading">
                    <h5 class="">Recent Orders</h5>
                </div>
    
                <div class="widget-content">
                    <div class="table-responsive">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th><div class="th-content">Customer</div></th>
                                    <th><div class="th-content">Product</div></th>
                                    <th><div class="th-content">Invoice</div></th>
                                    <th><div class="th-content th-heading">Price</div></th>
                                    <th><div class="th-content">Status</div></th>
                                </tr>
                            </thead>
                            <tbody>
                                    @foreach(var data in Model.PurchasedProduct)
                                    {
                                        <tr>
                                            <td><div class="td-content customer-name"><img src="~/src/assets/img/OakMartLogo.png" alt="avatar"><span>@data.Users.Username</span></div></td>
                                            <td><div class="td-content product-brand text-primary">@data.ProductVariants.Material - @data.ProductVariants.Product.Name</div></td>
                                            <td><div class="td-content product-invoice">#1000@(data.Id)</div></td>
                                            <td>
                                                <div class="td-content pricing">
                                                    <span class="">
                                                        @($"₱{data.Price:N2}")
                                                    </span>
                                                </div>
                                            </td>
                                            @if (data.PaymentStatus == "Pending")
                                            {
                                                <td><div class="td-content"><span class="badge badge-warning">Pending</span></div></td>
                                            }
                                            else
                                            {
                                                <td><div class="td-content"><span class="badge badge-success">Paid</span></div></td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    
        <div class="col-xl-6 col-lg-12 col-md-12 col-sm-12 col-12 layout-spacing">
            <div class="widget widget-table-three">
    
                <div class="widget-heading">
                    <h5 class="">Top Selling Product</h5>
                </div>
    
                <div class="widget-content">
                    <div class="table-responsive">
                        <table class="table table-scroll">
                            <thead>
                                <tr>
                                    <th><div class="th-content">Product</div></th>
                                    <th><div class="th-content th-heading">Price</div></th>
                                    <th><div class="th-content th-heading">Discount</div></th>
                                    <th><div class="th-content">Sold</div></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var data in Model.ProductVariants)
                                {
                                    <tr>
                                        <td><div class="td-content product-name"><img src="@data.ProductImage" alt="product"><div class="align-self-center"><p class="prd-name">@data.Product.Name</p><p class="prd-category text-primary">@data.Material</p><p class="text-mute">@(data.Dimension??"Default")</p></div></div></td>
                                        <td><div class="td-content"><span class="pricing">₱@data.Price.ToString("N2")</span></div></td>
                                        <td><div class="td-content"><span class="discount-pricing">@(data.Discount.ToString()??"No discount")%</span></div></td>
                                        <td><div class="td-content">@data.PurchasedProduct.Sum(u => u.Quantity)</div></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    
    </div>
    }

}
@{
    // Base range (oldest purchase to today)
    var startDate = Model.PurchasedProduct.Min(p => p.PurchasedDate);
    var endDate = DateTime.Now;

    // Build datasets
    var dailyData = Enumerable.Range(0, (endDate - startDate).Days + 1)
        .Select(i => startDate.AddDays(i))
        .Select(date => new
        {
            Label = date.ToString("MMM dd"),
            Value = Model.PurchasedProduct
                .Where(p => p.PurchasedDate.Date == date.Date)
                .Sum(p => (double?)p.Price ?? 0)
        }).ToList();

    var weeklyData = Enumerable.Range(0, (int)Math.Ceiling((endDate - startDate).TotalDays / 7))
        .Select(i => startDate.AddDays(i * 7))
        .Select(weekStart => new
        {
            Label = $"{weekStart:MMM dd}",
            Value = Model.PurchasedProduct
                .Where(p => p.PurchasedDate >= weekStart && p.PurchasedDate < weekStart.AddDays(7))
                .Sum(p => (double?)p.Price ?? 0)
        }).ToList();

    var monthlyData = Enumerable.Range(0, ((endDate.Year - startDate.Year) * 12) + endDate.Month - startDate.Month + 1)
        .Select(i => startDate.AddMonths(i))
        .Select(month => new
        {
            Label = month.ToString("MMM yyyy"),
            Value = Model.PurchasedProduct
                .Where(p => p.PurchasedDate.Year == month.Year && p.PurchasedDate.Month == month.Month)
                .Sum(p => (double?)p.Price ?? 0)
        }).ToList();
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const datasets = {
            daily: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dailyData.Select(d => d.Label))),
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(dailyData.Select(d => d.Value)))
            },
            weekly: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(weeklyData.Select(d => d.Label))),
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(weeklyData.Select(d => d.Value)))
            },
            monthly: {
                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(monthlyData.Select(d => d.Label))),
                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(monthlyData.Select(d => d.Value)))
            }
        };

        const ctx = document.getElementById('revenueChart').getContext('2d');

        let chart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: datasets.daily.labels,
                datasets: [{
                    label: 'Total Sales (₱)',
                    data: datasets.daily.data,
                    borderColor: '#28a745',
                    backgroundColor: 'rgba(40,167,69,0.1)',
                    fill: true,
                    tension: 0.4,
                    pointRadius: 4,
                    pointBackgroundColor: '#28a745'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'top' },
                    title: {
                        display: true,
                        text: 'Total Sales Over Time'
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: value => '₱' + value.toLocaleString()
                        }
                    },
                    x: {
                        grid: { display: false }
                    }
                }
            }
        });

        // Handle dropdown change
        document.getElementById('timeRange').addEventListener('change', function () {
            const selected = this.value;
            chart.data.labels = datasets[selected].labels;
            chart.data.datasets[0].data = datasets[selected].data;
            chart.update();
        });
    </script>
}