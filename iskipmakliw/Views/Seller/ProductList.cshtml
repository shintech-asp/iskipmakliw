@{
    ViewData["Title"] = "Product";
    Layout = "_LayoutSeller";
}
@model List<Product>;
<div class="row layout-top-spacing">
    <div class="row my-3">
        <div class="col text-start">
            <h5>Product</h5>
        </div>
        <div class="col text-end">
            <a class="btn btn-info" asp-controller="Seller" asp-action="ProductAdd">Add product</a>
        </div>
    </div>
    <div class="col-xl-12 col-lg-12 col-sm-12  layout-spacing">
        <div class="widget-content widget-content-area br-8">
            <div id="ecommerce-list_wrapper" class="dataTables_wrapper container-fluid dt-bootstrap4 no-footer">
                <div class="dt--top-section"></div>
                    <table id="ecommerce-list" class="table dt-table-hover dataTable no-footer" style="width: 100%;" role="grid" aria-describedby="ecommerce-list_info">
                        <thead>
                        <tr role="row">
                                <th tabindex="0" aria-controls="ecommerce-list" rowspan="1" colspan="1" aria-label="Product:" style="width: 239px;">Product</th>
                                <th tabindex="0" aria-controls="ecommerce-list" rowspan="1" colspan="1" aria-label="Status: " style="width: 115px;">Status</th>
                                <th tabindex="0" aria-controls="ecommerce-list" rowspan="1" colspan="1" aria-label="Action: " style="width: 70px;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (Model.Count > 0)
                        {
                            @foreach (var data in Model)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="~/uploads/@data.Image"
                                                 alt="@data.Name"
                                                 width="60"
                                                 height="60"
                                                 class="rounded me-2"
                                                 style="object-fit: cover;" />

                                            <span class="fw-bold">@data.Name</span>
                                        </div>
                                    </td>

                                    @{
                                        string badge;
                                        string stock;

                                        if (data.ProductVariants.Count == 0)
                                        {
                                            badge = "badge bg-danger";
                                            stock = "No item";
                                        }
                                        else
                                        {
                                            badge = "badge bg-success";
                                            stock = $"{data.ProductVariants.Count} in stock";
                                        }
                                    }

                                    <td>
                                        <span class="@badge">@stock</span>
                                    </td>

                                    <td> <div class="dropdown"> <a class="dropdown-toggle" href="#" role="button" id="dropdownMenuLink1" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="true"> <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-more-horizontal"><circle cx="12" cy="12" r="1"></circle><circle cx="19" cy="12" r="1"></circle><circle cx="5" cy="12" r="1"></circle></svg> </a> <div class="dropdown-menu" aria-labelledby="dropdownMenuLink1"> <a class="dropdown-item" asp-controller="Seller" asp-action="ProductDetails" asp-route-Id="@data.Id">View</a> </div> </div> </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3">No item yet</td>
                            </tr>
                        }
                    </tbody>
                    </table>
                    </div>
            </div>
        </div>
    </div>

<div class="modal fade" id="ProductAddModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Add Product</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Seller" asp-action="ProductAdd" method="post" enctype="multipart/form-data">
            <div class="modal-body">
                <div class="row mb-4">
                    <div class="col-sm-12">
                        <input type="text" class="form-control" name="Name" placeholder="Product Name">
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-sm-12">
                        <label>Description</label>

                        <textarea class="form-control" name="Details" rows="10"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="submit" class="btn btn-primary">Save changes</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        $("#AddProduct").on("click", function(){
            $("#ProductAddModal").modal("show")
        })
    </script>
}