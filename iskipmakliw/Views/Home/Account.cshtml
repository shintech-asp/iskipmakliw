<style>
    .section.general-info.payment-info {
        overflow: visible !important;
    }

    #map {
        height: 500px !important;
        width: 100% !important;
        min-height: 500px;
        position: relative;
        z-index: 1;
    }

    .leaflet-container {
        height: 100% !important;
    }

    .my-leaflet-map-container img {
        max-height: none;
    }
</style>
@section Scripts {
    <script>
        $(document).ready(function () {
            const form = $("#profileForm");
            const submissionTypeInput = $("#submissionType");


            function confirmAndSubmit(type, title, message) {
                Swal.fire({
                    title: title,
                    text: message,
                    icon: "question",
                    showCancelButton: true,
                    confirmButtonText: "Yes, continue",
                    cancelButtonText: "Cancel",
                }).then((result) => {
                    if (result.isConfirmed) {
                        submissionTypeInput.val(type);
                        form.submit(); // Regular POST submission
                    }
                });
            }

            $("#ProfileSave").on("click", function (e) {
                e.preventDefault();
                confirmAndSubmit(1, "Save Profile", "Do you want to save your profile changes?");
            });
            $("#AddressSave").on("click", function (e) {
                e.preventDefault();
                confirmAndSubmit(2, "Add Billing Address", "Do you want to add this billing address?");
            });
            $("#PaymentSave").on("click", function (e) {
                e.preventDefault();
                confirmAndSubmit(3, "Add Payment Method", "Do you want to add this payment method?");
            });
        });

                      // Initialize map after everything is loaded
        $(window).on('load', function () {
            // Ensure map container has proper styling
            $('#map').css({
                'height': '500px',
                'width': '100%',
                'position': 'relative',
                'display': 'block'
            });

            // Small delay to ensure Bootstrap layout is complete
            setTimeout(function() {
                // Create map instance
                const map = L.map('map', { center: [14.5995, 120.9842], // Default: Manila 
                    zoom: 13, scrollWheelZoom: true }); 
                    // Add OpenStreetMap tile layer 
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: '&copy; OpenStreetMap contributors' }).addTo(map);

                let marker;

                // Force multiple redraws to fix Bootstrap container issues
                setTimeout(() => map.invalidateSize(), 100);
                setTimeout(() => map.invalidateSize(), 300);
                setTimeout(() => map.invalidateSize(), 600);

                // Handle window resize
                $(window).on('resize', function() {
                    map.invalidateSize();
                });

                // Handle map click
                map.on('click', async function (e) {
                    const lat = e.latlng.lat.toFixed(6);
                    const lng = e.latlng.lng.toFixed(6);

                    // Update or create marker
                    if (marker) {
                        marker.setLatLng([lat, lng]);
                    } else {
                        marker = L.marker([lat, lng]).addTo(map);
                    }

                    // Update hidden input fields
                    $('#latitude').val(lat);
                    $('#longitude').val(lng);

                    // Show loading state (optional)
                    $('#Address').val('Loading address...');

                    // Reverse Geocode using Nominatim
                    try {

                        const response = await fetch(`/reverse-geocode?lat=${lat}&lon=${lng}`);

                        if (!response.ok) {
                            throw new Error('Geocoding service unavailable');
                        }

                        const data = await response.json();

                        // Safely extract address data
                        const address = data.address || {};
                        $('#Address').val(data.display_name || 'Address not found');
                        $('#City').val(address.city || address.town || address.village || address.municipality || '');
                        $('#Country').val(address.country || '');
                        $('#Zip').val(address.postcode || '');
                    } catch (err) {
                        console.error('Reverse geocoding failed:', err);
                        $('#Address').val('Unable to fetch address');
                        alert('Failed to get address information. Please try again.');
                    }
                });
            }, 250); // Initial delay for Bootstrap layout
        });
    </script>

}