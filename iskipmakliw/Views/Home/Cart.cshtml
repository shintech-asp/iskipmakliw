@using iskipmakliw.Models.ViewModels
@{
    ViewData["Title"] = "My Cart";
    Layout = "_LayoutCustomer";
}
@model CartViewModel
<form id="checkoutForm" asp-action="PayProduct" asp-controller="Payments">
    <div class="container-fluid mt-4">
        <div class="row">
            <!-- Cart Items -->
            <div class="col-lg-8 col-md-12">
                <div class="card mb-4">
                    <div class="card-header">
                        <h4 class="mb-0 text-black">🛒 Shopping Cart</h4>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-bordered align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Select</th>
                                        <th>Product</th>
                                        <th>Price</th>
                                        <th>Quantity</th>
                                        <th>Total</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody id="cartBody">
                                    @if (Model.Cart.Any())
                                    {

                                        <input type="hidden" name="shippingFee" id="shippingPayment" />
                                        @foreach (var shopGroup in Model.Cart)
                                        {
                                            <tr class="table-secondary">
                                                <td colspan="6"><strong>@shopGroup.Key</strong></td>
                                            </tr>

                                            @foreach (var item in shopGroup.Value)
                                            {
                                                var price = item.ProductVariants.Price;
                                                var quantity = item.Quantity;
                                                var discount = item.ProductVariants.Discount;
                                                double? discountedPrice;
                                                double? total;
                                                if (discount != null)
                                                {
                                                    if(item.ProductVariants.DiscountType == "Peso")
                                                    {
                                                        discountedPrice = price - discount;
                                                        total = discountedPrice * quantity;
                                                    }
                                                    else
                                                    {
                                                        discountedPrice = price - (price * discount / 100);
                                                        total = discountedPrice * quantity;
                                                    }
                                                }
                                                else
                                                {
                                                    total = price;
                                                    discountedPrice = price;
                                                }

                                                <tr class="cart-item"
                                                    data-price="@discountedPrice"
                                                    data-id="@item.ProductVariants.Id"
                                                    data-seller-lat="@item.ProductVariants?.Product?.Users?.UserDetails?.Latitude"
                                                    data-seller-lng="@item.ProductVariants?.Product?.Users?.UserDetails?.Longitude">
                                                    <td class="text-center">
                                                        <input type="checkbox" class="cart-select" name="cartSelect" value="@item.Id"/>
                                                    </td>
                                                    <td>@item.ProductVariants.Product.Name</td>
                                                    <td>₱@price</td>
                                                    <td>
                                                        <input type="number"
                                                               class="form-control w-100 quantity"
                                                               name="Quantity"
                                                               data-id="@item.Id"
                                                               id="Quantity"
                                                               value="@quantity"
                                                               min="1"
                                                               max="@item.ProductVariants.Quantity">
                                                        <span class="text-danger d-block">@item.ProductVariants.Quantity pcs left</span>
                                                    </td>
                                                    <td class="item-total">₱@total</td>
                                                    <td>
                                                        <button id="removeBtn" data-id="@item.Id" class="btn btn-danger btn-sm">Remove</button>
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center">
                                                Choose your product first in
                                                <a class="btn btn-info" asp-action="Index" asp-controller="Home">Shop</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Summary + Payment + Address -->
            <div class="col-lg-4 col-md-12">
                <!-- Order Summary -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h4 class="mb-0 text-black">Order Summary</h4>
                    </div>
                    <div class="card-body">
                        <p class="d-flex justify-content-between">
                            <span>Subtotal</span>
                            <span id="subtotal">₱0.00</span>
                        </p>
                        <p class="d-flex justify-content-between">
                            <span>Shipping</span>
                            <span id="shipping">₱50.00</span>
                        </p>
                        <hr>
                        <h5 class="d-flex justify-content-between text-black">
                            <span>Total</span>
                            <span id="grandTotal">₱50.00</span>
                        </h5>
                    </div>
                </div>

                <!-- Payment Method -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h4 class="mb-0 text-black">Payment Method</h4>
                    </div>
                    <div class="card-body">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="paymentMethod" id="online" value="Online">
                            <label class="form-check-label" for="online">Online Payment</label>
                        </div>

                        <div id="onlineDetails" class="mt-3 ms-3" style="display:none;">
                            @if(Model.PaymentMethod.Count > 0)
                            {
                                @foreach (var data in Model.PaymentMethod)
                                {
                                    <div class="d-flex w-100 mb-2">
                                        <div class="form-check me-2">
                                            <input class="form-check-input" type="radio" value="@data.Id" name="paymentMethodOnline">
                                        </div>
                                        <div class="payment-card me-2">
                                            @if (data.Type == "Gcash")
                                            {
                                                <img src="~/src/assets/img/gcash.svg" alt="gcash" style="height:40px;">
                                            }
                                            else if (data.Type == "Maya")
                                            {
                                                <img src="~/src/assets/img/maya.png" alt="maya" style="height:40px;">
                                            }
                                        </div>
                                        <div class="billing-content">
                                            <strong>@data.Type</strong>
                                            <p>@data.Number</p>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="fst-italic text-center mb-4">Register online payment method first.</p>
                            }

                        </div>

                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="paymentMethod" id="cod" value="COD">
                            <label class="form-check-label" for="cod">Cash on Delivery (COD)</label>
                        </div>
                    </div>
                </div>

                <!-- Delivery Address -->
                <div class="card mb-4">
                    <div class="card-header">
                        <h4 class="mb-0 text-black">Delivery Address</h4>
                    </div>
                    <div class="card-body">
                        @if(Model.Billings.Count > 0)
                        {
                            @foreach (var data in Model.Billings)
                            {
                                <div class="form-check mb-3">
                                    <input class="form-check-input billing-radio"
                                           type="radio"
                                           name="billings"
                                           id="billing-@data.Id"
                                           value="@data.Id"
                                           data-lat="@data.Latitude"
                                           data-lng="@data.Longitude"
                                           @(data == Model.Billings.First() ? "checked" : "") />

                                    <label class="form-check-label w-100" for="billing-@data.Id">
                                        <strong>@data.Address</strong><br>
                                        <small>Contact Person: @data.Name</small><br>
                                        <small>Contact Number: @data.ContactNumber</small>
                                    </label>
                                </div>
                            }

                        }
                        else
                        {
                            <p class="fst-italic text-center">Register your delivery address first.</p>
                        }
                    </div>
                </div>

                <button type="button" id="checkoutBtn" class="btn btn-success w-100">
                    Proceed to Checkout
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
        document.getElementById("checkoutBtn").addEventListener("click", function () {

            const selectedItems = document.querySelectorAll(".cart-select:checked");

            if(selectedItems.length === 0){
                Swal.fire({
                    icon: "warning",
                    title: "No Item Selected",
                    text: "Please select at least one product to checkout."
                });
                return;
            }

            Swal.fire({
                title: "Proceed to Checkout?",
                text: "Please confirm your order before continuing.",
                icon: "question",
                showCancelButton: true,
                confirmButtonColor: "#28a745",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, checkout",
                cancelButtonText: "Cancel"
            }).then((result) => {
                if (result.isConfirmed) {
                    document.getElementById("checkoutForm").submit();
                }
            });

        });
        $("#Quantity").on("change", function(){
            var id = $(this).data("id");
            var quantity = $(this).val();
            $.ajax({
                url: "/Home/ModifyQuantity",
                method: "POST",
                data: {
                    id: id,
                    quantity: quantity
                },
                success: function(response){
                    console.log(response)
                },
                error: function(xhr){
                    console.log(xhr.responseText)
                }

            })
        })
        $("#removeBtn").on("click", function(){
            var id = $(this).data("id");
            $.ajax({
                url: "/Home/RemoveCart",
                method: "POST",
                data: {
                    id: id,
                },
                success: function(response){
                    console.log(response)
                },
                error: function(xhr){
                    console.log(xhr.responseText)
                }

            })
        })
                document.addEventListener("keydown", function (e) {
            // Prevent ENTER from submitting the form
            if (e.key === "Enter") {
                e.preventDefault();
                return false;
            }
        });
                document.querySelectorAll(".quantity").forEach(input => {
            input.addEventListener("keydown", function (e) {
                // Block ALL keys except Arrow Up and Arrow Down
                if (e.key !== "ArrowUp" && e.key !== "ArrowDown") {
                    e.preventDefault();
                }
            });
        });
            const cartCheckboxes = document.querySelectorAll(".cart-select");
            const billingRadios = document.querySelectorAll(".billing-radio");
            const paymentRadios = document.querySelectorAll("input[name='paymentMethod']");

            
            const paymentOnlineRadios = document.querySelectorAll(".payment-online");
            const onlineDetails = document.getElementById("onlineDetails");

            const cartInput = document.getElementById("CartId");
            const billingInput = document.getElementById("BillingsId");
            const paymentInput = document.getElementById("PaymentMethod");
            const checkoutBtn = document.getElementById("checkoutBtn");

        function updateSummary() {
            let subtotal = 0;
            document.querySelectorAll('.cart-item').forEach(row => {
                const checkbox = row.querySelector('.cart-select');
                const qty = parseInt(row.querySelector('.quantity').value) || 1;
                const price = parseFloat(row.dataset.price);

                const total = qty * price;
                row.querySelector('.item-total').textContent = `₱${total.toFixed(2)}`;

                if (checkbox.checked) {
                    subtotal += total;
                }
            });

            const grandTotal = subtotal > 0 ? subtotal + shippingFee : 0;
            document.getElementById('subtotal').textContent = `₱${subtotal.toFixed(2)}`;
            document.getElementById('grandTotal').textContent = `₱${grandTotal.toFixed(2)}`;
        }

        document.querySelectorAll('.cart-select, .quantity').forEach(el => {
            el.addEventListener('change', updateSummary);
        });

        // Show/hide online payment details
        document.querySelectorAll('input[name="paymentMethod"]').forEach(radio => {
            radio.addEventListener('change', function() {
                document.getElementById('onlineDetails').style.display =
                    this.value === 'Online' ? 'block' : 'none';
            });
        });

        // Initial total calculation
        updateSummary();
            // Toggle Online Payment Details
            paymentRadios.forEach(radio => {
                radio.addEventListener("change", function () {
                    if (this.value === "Online") {
                        onlineDetails.style.display = "block";
                    } else {
                        onlineDetails.style.display = "none";
                        paymentInput.value = "COD";
                    }
                });
            });

            // Select Online Payment ID
            paymentOnlineRadios.forEach(radio => {
                radio.addEventListener("change", function () {
                    if (this.checked) {
                        paymentInput.value = this.value;
                    }
                });
            });

            // Select Billing Address
            billingRadios.forEach(radio => {
                radio.addEventListener("change", function () {
                    billingInput.value = this.value;
                });
            });

            // Select Cart Items (multiple)
            cartCheckboxes.forEach(box => {
                box.addEventListener("change", function () {
                    const selected = Array.from(cartCheckboxes)
                        .filter(cb => cb.checked)
                        .map(cb => cb.value);
                    cartInput.value = selected.join(",");
                });
            });

            // Proceed to Checkout
            checkoutBtn.addEventListener("click", function (e) {
                e.preventDefault();

                if (!cartInput.value) {
                    Swal.fire("Oops!", "Please select at least one item from your cart.", "warning");
                    return;
                }
                if (!billingInput.value) {
                    Swal.fire("Oops!", "Please select a delivery address.", "warning");
                    return;
                }
                if (!paymentInput.value) {
                    Swal.fire("Oops!", "Please select a payment method.", "warning");
                    return;
                }

                Swal.fire({
                    title: "Proceed to Checkout?",
                    text: "Are you sure you want to place this order?",
                    icon: "question",
                    showCancelButton: true,
                    confirmButtonText: "Yes, Checkout",
                    cancelButtonText: "Cancel"
                }).then(result => {
                    if (result.isConfirmed) {
                        document.querySelector("form")?.submit();
                    }
                });
            });
        });
        const RATE_PER_KM = 30;
        const BASE_FEE = 150;      // first 5 km flat
        const BASE_DISTANCE = 3;   // km
        const shippingEl = document.getElementById("shipping");
        const subtotalEl = document.getElementById("subtotal");
        const grandTotalEl = document.getElementById("grandTotal");
        var shippingForm = document.getElementById("shippingPayment");

        // --- Haversine Distance ---
        function getDistanceKm(lat1, lon1, lat2, lon2) {
            const R = 6371;
            const dLat = (lat2 - lat1) * Math.PI / 180;
            const dLon = (lon2 - lon1) * Math.PI / 180;

            const a =
                Math.sin(dLat / 2) ** 2 +
                Math.cos(lat1 * Math.PI / 180) *
                Math.cos(lat2 * Math.PI / 180) *
                Math.sin(dLon / 2) ** 2;

            return R * (2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a)));
        }

        // --- Calculate shipping per seller ---
        function calculateShipping() {
            const selectedBilling = document.querySelector(".billing-radio:checked");
            if (!selectedBilling) return 0;

            const buyerLat = parseFloat(selectedBilling.dataset.lat);
            const buyerLng = parseFloat(selectedBilling.dataset.lng);

            const checkedItems = document.querySelectorAll(".cart-select:checked");
            const sellerMap = new Map(); // unique sellers only

            checkedItems.forEach(cb => {
                const row = cb.closest(".cart-item");
                const lat = row.dataset.sellerLat;
                const lng = row.dataset.sellerLng;

                if (lat && lng) {
                    sellerMap.set(`${lat},${lng}`, { lat, lng });
                }
            });

            let totalShipping = 0;

            sellerMap.forEach(seller => {
                const distance = getDistanceKm(
                    buyerLat,
                    buyerLng,
                    parseFloat(seller.lat),
                    parseFloat(seller.lng)
                );

                // Apply base fee for first 5 km
                if (distance <= BASE_DISTANCE) {
                    totalShipping += BASE_FEE;
                } else {
                    const extraKm = Math.ceil(distance - BASE_DISTANCE);
                    totalShipping += BASE_FEE + (extraKm * RATE_PER_KM);
                }
            });

            return totalShipping;
        }

        // --- Update summary ---
        function updateSummary() {
            let subtotal = 0;

            document.querySelectorAll(".cart-item").forEach(row => {
                const checkbox = row.querySelector(".cart-select");
                const qty = parseInt(row.querySelector(".quantity").value) || 1;
                const price = parseFloat(row.dataset.price);
                const total = qty * price;

                row.querySelector(".item-total").textContent = `₱${total.toFixed(2)}`;

                if (checkbox.checked) {
                    subtotal += total;
                }
            });

            const shipping = subtotal > 0 ? calculateShipping() : 0;
            const grandTotal = subtotal + shipping;

            subtotalEl.textContent = `₱${subtotal.toFixed(2)}`;
            shippingEl.textContent = `₱${shipping.toFixed(2)}`;
            grandTotalEl.textContent = `₱${grandTotal.toFixed(2)}`;
            shippingForm.value = shipping;
        }

        // --- Events ---
        document.querySelectorAll(".cart-select, .quantity").forEach(el => {
            el.addEventListener("change", updateSummary);
        });

        document.querySelectorAll(".billing-radio").forEach(radio => {
            radio.addEventListener("change", updateSummary);
        });

        updateSummary(); // initial
    </script>
}
