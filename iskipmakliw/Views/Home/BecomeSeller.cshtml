@{
    ViewData["Title"] = "Registration";
    Layout = "_LayoutCustomer";
}
@model List<Plans>;

<div class="row layout-top-spacing" id="cancel-row">
    <div class="col-lg-12 layout-spacing">
        <div class="statbox widget box box-shadow p-3">
            <div class="widget-header">
                <div class="row">
                    <div class="col-12">
                        <h4>Become a Seller</h4>
                    </div>
                </div>
            </div>
            <div class="widget-content widget-content-area">

                <!-- ══ STEPPER HEADER (visual only – clicking does nothing) ══ -->
                <div class="seller-stepper-header">
                    <div class="seller-step-tab" id="stab-0">
                        <span class="seller-circle">1</span>
                        <span class="seller-label">Identification</span>
                    </div>
                    <div class="seller-line"></div>
                    <div class="seller-step-tab" id="stab-1">
                        <span class="seller-circle">2</span>
                        <span class="seller-label">Verification</span>
                    </div>
                    <div class="seller-line"></div>
                    <div class="seller-step-tab" id="stab-2">
                        <span class="seller-circle">3</span>
                        <span class="seller-label">Payment</span>
                    </div>
                    <div class="seller-line"></div>
                    <div class="seller-step-tab" id="stab-3">
                        <span class="seller-circle">4</span>
                        <span class="seller-label">Location</span>
                    </div>
                    <div class="seller-line"></div>
                    <div class="seller-step-tab" id="stab-4">
                        <span class="seller-circle">5</span>
                        <span class="seller-label">Subscription</span>
                    </div>
                </div><!-- /.seller-stepper-header -->

                <form asp-controller="Home" asp-action="BecomeSeller"
                      method="post" enctype="multipart/form-data"
                      id="sellerForm" novalidate>

                    <!-- ══════════════════════════════════════════════════
                         STEP 1 – Identification
                         TypeId     : required
                         govPicture : required
                    ══════════════════════════════════════════════════ -->
                    <div id="sp1" class="seller-panel">
                        <div class="mb-3">
                            <label class="form-label">Type of ID <span class="text-danger">*</span></label>
                            <select class="form-select" name="TypeId" id="TypeId">
                                <option value="">-- Select ID Type --</option>
                                <option value="Drivers License">Driver's License</option>
                                <option value="PhilSys">PhilSys</option>
                                <option value="Passport">Passport</option>
                                <option value="Tin">TIN</option>
                            </select>
                            <div class="invalid-feedback" id="err-TypeId"></div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Upload Government ID <span class="text-danger">*</span></label>
                            <input type="file" id="govPicture" name="GovernmentIdFile"
                                   class="filepond w-50" data-max-file-size="3MB" data-max-files="1" />
                            <div class="pond-error" id="err-govPicture"></div>
                        </div>

                        <div class="seller-btns mt-4">
                            <button type="button" class="btn btn-secondary" disabled>Prev</button>
                            <button type="button" class="btn btn-primary" id="nxt1">Next</button>
                        </div>
                    </div>

                    <!-- ══════════════════════════════════════════════════
                         STEP 2 – Face Verification
                         idPicture : required
                    ══════════════════════════════════════════════════ -->
                    <div id="sp2" class="seller-panel" style="display:none;">

                        <div class="text-center mb-4" id="cameraDiv">
                            <h5 class="mb-2">Camera Preview</h5>
                            <video id="camera" width="480" height="360" autoplay
                                   class="border rounded" style="max-width:100%;"></video>
                            <br />
                            <button id="capture" type="button" class="btn btn-primary mt-3">
                                📸 Capture Photo
                            </button>
                        </div>

                        <!-- Capture preview modal -->
                        <div class="modal fade" id="previewModal" tabindex="-1" aria-hidden="true">
                            <div class="modal-dialog modal-lg modal-dialog-centered">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title">Preview Capture</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body text-center">
                                        <img id="capturedImg" class="img-fluid rounded" alt="Captured face" />
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" id="retake" class="btn btn-secondary" data-bs-dismiss="modal">Retake</button>
                                        <button type="button" id="accept" class="btn btn-success">Accept</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Selfie / Face Photo <span class="text-danger">*</span></label>
                            <input type="file" id="idPicture" name="CapturedIdFile"
                                   class="filepond" data-max-file-size="3MB" data-max-files="1" />
                            <div class="pond-error" id="err-idPicture"></div>
                        </div>

                        <div class="seller-btns mt-4">
                            <button type="button" class="btn btn-secondary" id="prev2">Prev</button>
                            <button type="button" class="btn btn-primary" id="nxt2">Next</button>
                        </div>
                    </div>

                    <!-- ══════════════════════════════════════════════════
                         STEP 3 – Payment Details
                         AccountName   : required | letters only | min 2
                         AccountNumber : required | 11 digits | starts with 0
                         Ewallet       : required
                    ══════════════════════════════════════════════════ -->
                    <div id="sp3" class="seller-panel" style="display:none;">
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">Account Name <span class="text-danger">*</span></label>
                                <input type="text" id="AccountName" name="AccountName"
                                       class="form-control" placeholder="e.g. Juan Dela Cruz" />
                                <div class="invalid-feedback" id="err-AccountName"></div>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Account Number <span class="text-danger">*</span></label>
                                <input type="text" id="AccountNumber" name="AccountNumber"
                                       class="form-control" maxlength="11" inputmode="numeric"
                                       placeholder="09XXXXXXXXX"
                                       oninput="enforceLeadingZero(this)" />
                                <div class="form-text text-muted">11 digits, must start with 0 (e.g. 09XXXXXXXXX).</div>
                                <div class="invalid-feedback" id="err-AccountNumber"></div>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Account Type <span class="text-danger">*</span></label>
                                <select class="form-select" name="Ewallet" id="Ewallet">
                                    <option value="">-- Select Account Type --</option>
                                    <option value="Maya">PayMaya</option>
                                    <option value="Gcash">GCash</option>
                                </select>
                                <div class="invalid-feedback" id="err-Ewallet"></div>
                            </div>
                        </div>

                        <div class="seller-btns mt-4">
                            <button type="button" class="btn btn-secondary" id="prev3">Prev</button>
                            <button type="button" class="btn btn-primary" id="nxt3">Next</button>
                        </div>
                    </div>

                    <!-- ══════════════════════════════════════════════════
                         STEP 4 – Location
                         Map pin : required – inside Cavite, not water
                    ══════════════════════════════════════════════════ -->
                    <div id="sp4" class="seller-panel" style="display:none;">
                        <div class="row g-3 mb-3">
                            <div class="col-12">
                                <label class="form-label">Address</label>
                                <input type="text" name="Address" id="Address" class="form-control" readonly
                                       placeholder="Auto-filled after pinning a location" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">City</label>
                                <input type="text" name="City" id="City" class="form-control" readonly />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Country</label>
                                <input type="text" name="Country" id="Country" class="form-control" readonly />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">ZIP</label>
                                <input type="tel" name="Zip" id="Zip" class="form-control" readonly />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Landmark <span class="text-muted small">(optional)</span></label>
                                <input type="text" name="LandMark" id="LandMark" class="form-control"
                                       placeholder="e.g. Near SM City Bacoor" />
                            </div>
                        </div>

                        <h5 class="mb-1">Select Your Store Location <span class="text-danger">*</span></h5>
                        <p class="text-muted small mb-2">
                            Search for a place or click on the map. Only land areas inside Cavite are accepted.
                        </p>

                        <!-- MAP SEARCH BAR -->
                        <div class="input-group mb-3" id="mapSearchWrapper" style="position:relative;">
                            <span class="input-group-text">
                                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.099zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                                </svg>
                            </span>
                            <input type="text" id="mapSearchInput" class="form-control"
                                   placeholder="Search a place in Cavite (e.g. Dasmarinas, Bacoor…)"
                                   autocomplete="off" />
                            <button class="btn btn-outline-secondary" type="button" id="mapSearchBtn">Search</button>
                            <div id="mapSearchResults" class="list-group"
                                 style="position:absolute;top:100%;left:0;right:0;z-index:9999;display:none;max-height:220px;overflow-y:auto;"></div>
                        </div>

                        <div id="map"></div>
                        <div class="pond-error mt-2" id="err-location"></div>
                        <input type="text" name="Latitude" id="latitude" hidden />
                        <input type="text" name="Longitude" id="longitude" hidden />

                        <div class="seller-btns mt-4">
                            <button type="button" class="btn btn-secondary" id="prev4">Prev</button>
                            <button type="button" class="btn btn-primary" id="nxt4">Next</button>
                        </div>
                    </div>

                    <!-- ══════════════════════════════════════════════════
                         STEP 5 – Subscription
                         PlansId : required
                    ══════════════════════════════════════════════════ -->
                    <div id="sp5" class="seller-panel" style="display:none;">
                        <div class="pricing-table-2">
                            <div class="pricing-plans-container mt-4 billed-yearly">

                                @foreach (var data in Model)
                                {
                                    @if (data.Id != 1)
                                    {
                                        <div class="pricing-plan mb-5 recommanded">
                                            @{
                                                if (data.Discount != 0)
                                                {
                                                    <span class="badge badge-pill badge-warning show">@data.Discount% Off</span>
                                                }
                                                <div class="pricing-header-section">
                                                    <div class="pricing-header">
                                                        <h3>@data.PlanName</h3>
                                                        @if (data.PlanName == "Annual")
                                                        {
                                                            <p>Recommended</p>
                                                        }
                                                    </div>
                                                    <div class="pricing-header-pricing">
                                                        <p class="pricing yearly-pricing">
                                                            @String.Format(new System.Globalization.CultureInfo("en-PH"), "{0:C}", data.Price)
                                                        </p>
                                                        <p class="sub-title monthly-pricing-label">@data.PlanName</p>
                                                    </div>
                                                </div>
                                            }
                                            <div class="pricing-plan-features mb-4">
                                                <ul>
                                                    <li>
                                                        <span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-check"><polyline points="20 6 9 17 4 12"></polyline></svg></span> Unlimited
                                                    </li>
                                                    <li>
                                                        <span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-check"><polyline points="20 6 9 17 4 12"></polyline></svg></span> 3D Modeling for customer
                                                    </li>
                                                    <li>
                                                        <span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-check"><polyline points="20 6 9 17 4 12"></polyline></svg></span> Featured products
                                                    </li>
                                                    @{
                                                        double? total = data.Price - (data.Price * (data.Discount / 100.0));
                                                    }
                                                    <li>
                                                        <span><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-check"><polyline points="20 6 9 17 4 12"></polyline></svg></span> For just @total pesos / @data.PlanName
                                                    </li>
                                                </ul>
                                            </div>
                                            <div class="text-center">
                                                <input name="PlansId" class="form-check-input"
                                                       type="radio" id="plan-@data.Id" value="@data.Id" />
                                            </div>
                                        </div>
                                    }
                                }

                            </div>
                        </div>
                        <div class="pond-error text-center mt-2" id="err-PlansId"></div>

                        <div class="seller-btns mt-4">
                            <button type="button" class="btn btn-secondary" id="prev5">Prev</button>
                            <button type="submit" class="btn btn-success" id="submitBtn">Submit</button>
                        </div>
                    </div>

                </form>

            </div><!-- /.widget-content -->
        </div>
    </div>
</div>

<canvas id="snapshot" width="640" height="480" style="display:none;"></canvas>

<style>
    /* ── Stepper header ────────────────────────────────────── */
    .seller-stepper-header {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0;
        padding: 1rem 0 1.5rem;
    }

    .seller-step-tab {
        display: flex;
        align-items: center;
        gap: .45rem;
        opacity: .45;
        transition: opacity .2s;
    }

        .seller-step-tab.active {
            opacity: 1;
        }

    .seller-circle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #888;
        color: #fff;
        font-weight: 700;
        font-size: .85rem;
        flex-shrink: 0;
        transition: background .2s;
    }

    .seller-step-tab.active .seller-circle {
        background: #4361ee;
    }

    .seller-label {
        font-size: .82rem;
        font-weight: 500;
        white-space: nowrap;
    }

    .seller-line {
        flex: 1;
        min-width: 20px;
        height: 2px;
        background: #ddd;
        margin: 0 6px;
    }

    /* ── Step panels – ONLY our class controls visibility ────── */
    /* We deliberately do NOT use bsStepper classes so their CSS can't hide our panels */
    .seller-panel {
        padding: .5rem 0;
    }

    /* ── Button row ───────────────────────────────────────────── */
    .seller-btns {
        display: flex;
        gap: .5rem;
    }

    /* ── FilePond: rectangular preview ───────────────────────── */
    .filepond--image-preview-wrapper,
    .filepond--image-preview,
    .filepond--image-clip,
    .filepond--item-panel,
    .filepond--panel-root,
    .filepond--drip-blob,
    .filepond--drop-label {
        border-radius: 4px !important;
    }

    .filepond--image-clip {
        width: 100% !important;
        height: 100% !important;
        margin: 0 !important;
    }

    /* ── Inline field validation ──────────────────────────────── */
    .is-invalid ~ .invalid-feedback {
        display: block;
    }

    .invalid-feedback {
        color: #e7515a;
        font-size: .82rem;
        margin-top: 3px;
    }

    .pond-error {
        display: none;
        color: #e7515a;
        font-size: .82rem;
    }

        .pond-error.show {
            display: block;
        }

    /* ── Map ──────────────────────────────────────────────────── */
    #map {
        height: 500px;
        width: 100%;
        border-radius: 8px;
    }

    /* ── Search dropdown ──────────────────────────────────────── */
    #mapSearchResults .list-group-item {
        cursor: pointer;
        font-size: .875rem;
    }

        #mapSearchResults .list-group-item:hover {
            background: #f0f4ff;
        }
</style>

@section Scripts {
    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <script src="https://unpkg.com/@@turf/turf/turf.min.js"></script>

    <script>
        // ═══════════════════════════════════════════════════════════════════
        //  STEPPER
        // ═══════════════════════════════════════════════════════════════════
        const PANELS  = ['sp1','sp2','sp3','sp4','sp5'];
        const TABS    = ['stab-0','stab-1','stab-2','stab-3','stab-4'];
        let   current = 0;

        function showStep(n) {
            PANELS.forEach(function(id, i) {
                document.getElementById(id).style.display = (i === n) ? '' : 'none';
            });
            TABS.forEach(function(id, i) {
                document.getElementById(id).classList.toggle('active', i === n);
            });
            current = n;

            // Side-effects
            if (n === 1) {                          // Step 2 – camera
                document.getElementById('cameraDiv').style.display = '';
                if (!stream) startCamera();
            } else {
                stopCamera();
            }
            if (n === 3) {                          // Step 4 – map
                setTimeout(initMap, 300);
            }
        }

        document.addEventListener('DOMContentLoaded', function () {
            // Next
            document.getElementById('nxt1').addEventListener('click', function() { if (validateStep1()) showStep(1); });
            document.getElementById('nxt2').addEventListener('click', function() { if (validateStep2()) showStep(2); });
            document.getElementById('nxt3').addEventListener('click', function() { if (validateStep3()) showStep(3); });
            document.getElementById('nxt4').addEventListener('click', function() { if (validateStep4()) showStep(4); });
            // Prev
            document.getElementById('prev2').addEventListener('click', function() { showStep(0); });
            document.getElementById('prev3').addEventListener('click', function() { showStep(1); });
            document.getElementById('prev4').addEventListener('click', function() { showStep(2); });
            document.getElementById('prev5').addEventListener('click', function() { showStep(3); });
            // Submit
            document.getElementById('sellerForm').addEventListener('submit', function(e) {
                if (!validateStep5()) { e.preventDefault(); return; }
                if (!pondGov.getFiles().length || !pondId.getFiles().length) {
                    e.preventDefault();
                    Swal.fire({ icon:'error', title:'Missing Uploads',
                        text:'Required file uploads are missing. Go back and complete all upload fields.',
                        confirmButtonColor:'#d33' });
                }
            });
            // Show step 1
            showStep(0);
        });

        // ═══════════════════════════════════════════════════════════════════
        //  ACCOUNT NUMBER – digits only, always starts with 0
        // ═══════════════════════════════════════════════════════════════════
        function enforceLeadingZero(input) {
            let v = input.value.replace(/\D/g, '');
            if (v.length > 0 && v[0] !== '0') v = '0' + v;
            if (v.length > 11) v = v.slice(0, 11);
            input.value = v;
        }

        // ═══════════════════════════════════════════════════════════════════
        //  CAMERA
        // ═══════════════════════════════════════════════════════════════════
        const video        = document.getElementById('camera');
        const canvas       = document.getElementById('snapshot');
        const ctx          = canvas.getContext('2d');
        const capturedImg  = document.getElementById('capturedImg');
        const previewModal = new bootstrap.Modal(document.getElementById('previewModal'));
        let   stream       = null;

        function startCamera() {
            navigator.mediaDevices.getUserMedia({ video: true })
                .then(function(s) { stream = s; video.srcObject = s; })
                .catch(function(e) { console.warn('Camera unavailable:', e); });
        }
        function stopCamera() {
            if (stream) { stream.getTracks().forEach(function(t){ t.stop(); }); video.srcObject = null; stream = null; }
        }

        document.getElementById('capture').addEventListener('click', function() {
            ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
            capturedImg.src = canvas.toDataURL('image/png');
            previewModal.show();
        });
        document.getElementById('retake').addEventListener('click', function() { previewModal.hide(); startCamera(); });
        document.getElementById('accept').addEventListener('click', function() {
            fetch(capturedImg.src).then(function(r){ return r.blob(); }).then(function(blob) {
                pondId.removeFiles();
                pondId.addFile(new File([blob], 'selfie.png', { type:'image/png' }));
                previewModal.hide();
                stopCamera();
                document.getElementById('cameraDiv').style.display = 'none';
            });
        });

        // ═══════════════════════════════════════════════════════════════════
        //  FILEPOND
        // ═══════════════════════════════════════════════════════════════════
        FilePond.setOptions({ server: null, instantUpload: false, storeAsFile: true });

        const pondGov = FilePond.create(document.getElementById('govPicture'), {
            name: 'GovernmentIdFile', storeAsFile: true, allowMultiple: false,
            maxFiles: 1, imageCropAspectRatio: null
        });
        const pondId = FilePond.create(document.getElementById('idPicture'), {
            name: 'CapturedIdFile', storeAsFile: true, allowMultiple: false,
            maxFiles: 1, imageCropAspectRatio: null
        });

        // ═══════════════════════════════════════════════════════════════════
        //  VALIDATION HELPERS
        // ═══════════════════════════════════════════════════════════════════
        function setField(id, ok, msg) {
            var el  = document.getElementById(id);
            var err = document.getElementById('err-' + id);
            if (!el) return;
            el.classList.toggle('is-invalid', !ok);
            el.classList.toggle('is-valid',    ok);
            if (err) err.textContent = ok ? '' : msg;
        }
        function setPondErr(id, ok, msg) {
            var el = document.getElementById(id);
            if (!el) return;
            el.textContent = ok ? '' : msg;
            el.classList.toggle('show', !ok);
        }
        function swalErrors(errs) {
            Swal.fire({
                icon: 'warning',
                title: 'Please fix the following:',
                html: '<ul style="text-align:left;margin:0;padding-left:1.3rem;line-height:1.9">'
                    + errs.map(function(e){ return '<li>' + e + '</li>'; }).join('') + '</ul>',
                confirmButtonColor: '#e2a03f',
                confirmButtonText: 'OK, fix it'
            });
        }

        // ─── Step 1 ───────────────────────────────────────────────────────
        function validateStep1() {
            var errs  = [];
            var typeOk = document.getElementById('TypeId').value !== '';
            setField('TypeId', typeOk, 'Please select the type of ID.');
            if (!typeOk) errs.push('Type of ID – selection required');

            var govOk = pondGov.getFiles().length > 0;
            setPondErr('err-govPicture', govOk, 'Please upload a photo of your government ID.');
            if (!govOk) errs.push('Government ID – photo upload required');

            if (errs.length) { swalErrors(errs); return false; }
            return true;
        }

        // ─── Step 2 ───────────────────────────────────────────────────────
        function validateStep2() {
            var errs  = [];
            var ok    = pondId.getFiles().length > 0;
            setPondErr('err-idPicture', ok, 'Please capture or upload your selfie.');
            if (!ok) errs.push('Selfie / Face Photo – capture or upload required');
            if (errs.length) { swalErrors(errs); return false; }
            return true;
        }

        // ─── Step 3 ───────────────────────────────────────────────────────
        function validateStep3() {
            var errs = [];

            var name   = document.getElementById('AccountName').value.trim();
            var nameOk = name.length >= 2 && /^[a-zA-Z\s.'ñÑ-]+$/.test(name);
            setField('AccountName', nameOk, 'Letters only, minimum 2 characters.');
            if (!nameOk) errs.push('Account Name – letters only, min 2 characters');

            var num    = document.getElementById('AccountNumber').value.trim();
            var numOk  = /^0\d{10}$/.test(num);
            var numMsg = 'Account number is required.';
            if (num.length > 0 && num[0] !== '0')        numMsg = 'Must start with 0 (e.g. 09XXXXXXXXX).';
            else if (num.length > 0 && num.length !== 11) numMsg = 'Must be exactly 11 digits starting with 0.';
            setField('AccountNumber', numOk, numMsg);
            if (!numOk) errs.push('Account Number – ' + numMsg);

            var eOk = document.getElementById('Ewallet').value !== '';
            setField('Ewallet', eOk, 'Please choose an account type.');
            if (!eOk) errs.push('Account Type – please choose GCash or PayMaya');

            if (errs.length) { swalErrors(errs); return false; }
            return true;
        }

        // ─── Step 4 ───────────────────────────────────────────────────────
        function validateStep4() {
            var errs = [];
            var lat  = document.getElementById('latitude').value.trim();
            var lng  = document.getElementById('longitude').value.trim();
            var addr = document.getElementById('Address').value.trim();
            var ok   = lat && lng && addr && addr !== 'Loading address…' && addr !== 'Checking location…';
            setPondErr('err-location', ok, 'Please click the map to pin your store location inside Cavite.');
            if (!ok) errs.push('Store Location – please drop a pin on the map');
            if (errs.length) { swalErrors(errs); return false; }
            return true;
        }

        // ─── Step 5 ───────────────────────────────────────────────────────
        function validateStep5() {
            var errs = [];
            var ok   = !!document.querySelector('input[name="PlansId"]:checked');
            setPondErr('err-PlansId', ok, 'Please select a subscription plan.');
            if (!ok) errs.push('Subscription Plan – please select a plan');
            if (errs.length) { swalErrors(errs); return false; }
            return true;
        }

        // ═══════════════════════════════════════════════════════════════════
        //  MAP + CAVITE BOUNDARY
        // ═══════════════════════════════════════════════════════════════════
        var mapInitialized = false;
        var leafletMap     = null;
        var mapMarker      = null;

               var caviteGeoJson = {
            type: 'Feature',
            geometry: {
                type: 'Polygon',
                coordinates: [[
                    // === NORTH COAST (Manila Bay shoreline – Kawit to Tanza) ===
                    [120.9034, 14.4389], // Kawit shore
                    [120.8789, 14.4289], // Noveleta shore
                    [120.8456, 14.4089], // Rosario shore
                    [120.8156, 14.3834], // Tanza north shore
                    [120.7923, 14.3623], // Tanza west shore
                    [120.7756, 14.3345], // Tanza southwest
                    [120.7689, 14.3056], // Naic north
                    [120.7534, 14.2789], // Naic shore
                    [120.7345, 14.2534], // Naic southwest
                    [120.7156, 14.2289], // Naic/Ternate boundary
                    [120.6978, 14.2056], // Ternate north
                    [120.6823, 14.1823], // Ternate west
                    [120.6712, 14.1589], // Ternate south
                    [120.6689, 14.1334], // Maragondon coast
                    [120.6723, 14.1089], // Maragondon south
                    // === SOUTH (inland boundary) ===
                    [120.6934, 14.0889],
                    [120.7234, 14.0756],
                    [120.7589, 14.0689],
                    [120.7934, 14.0712],
                    [120.8289, 14.0823],
                    [120.8634, 14.0978],
                    [120.8978, 14.1156],
                    [120.9289, 14.1389],
                    [120.9556, 14.1656],
                    [120.9778, 14.1956],
                    [120.9956, 14.2289],
                    [121.0089, 14.2623],
                    [121.0167, 14.2978],
                    [121.0189, 14.3334],
                    [121.0156, 14.3689],
                    [121.0067, 14.4023],
                    [120.9934, 14.4289],
                    [120.9734, 14.4445],
                    [120.9534, 14.4489],
                    [120.9334, 14.4456],
                    [120.9134, 14.4423],
                    [120.9034, 14.4389]  // close polygon back to Kawit
                ]]
            },
            properties: { name: 'Cavite Province' }
        };
                // Add this polygon near your caviteGeoJson definition
        var tanzaSeaExclusion = {
            type: 'Feature',
            geometry: {
                type: 'Polygon',
                coordinates: [[
                    [120.6689, 14.2456], [120.6712, 14.2156], [120.6789, 14.1856],
                    [120.6912, 14.1589], [120.6500, 14.1400], [120.6200, 14.1600],
                    [120.6100, 14.1900], [120.6150, 14.2200], [120.6400, 14.2500],
                    [120.6689, 14.2456]
                ]]
            }
        };
        function insideCavite(lat, lng) {
            return turf.booleanPointInPolygon(turf.point([lng, lat]), caviteGeoJson);
        }

                async function isWater(lat, lng) {
            var d    = 0.001; // wider ~100m radius – catches coastal sea areas
            var bbox = (lat-d) + ',' + (lng-d) + ',' + (lat+d) + ',' + (lng+d);
            var q    = '[out:json][timeout:10];('
                     + 'way["natural"="water"]('      + bbox + ');'
                     + 'relation["natural"="water"](' + bbox + ');'
                     + 'way["natural"="sea"]('        + bbox + ');'   // ← ADD
                     + 'relation["natural"="sea"]('   + bbox + ');'   // ← ADD
                     + 'way["natural"="bay"]('        + bbox + ');'
                     + 'relation["natural"="bay"]('   + bbox + ');'   // ← ADD
                     + 'way["natural"="coastline"]('  + bbox + ');'   // ← ADD (key fix for Tanza)
                     + 'way["waterway"~"river|stream|canal|drain"](' + bbox + ');'
                     + 'way["landuse"="reservoir"]('  + bbox + ');'
                     + 'relation["place"="sea"]('     + bbox + ');'
                     + ');out ids;';
            try {
                var resp = await fetch('https://overpass-api.de/api/interpreter', {
                    method: 'POST',
                    body:   'data=' + encodeURIComponent(q)
                });
                var json = await resp.json();
                return json.elements && json.elements.length > 0;
            } catch(e) {
                console.warn('Overpass water check failed – allowing pin:', e);
                return false;
            }
        }

        function initMap() {
            if (mapInitialized || typeof L === 'undefined' || typeof turf === 'undefined') return;
            mapInitialized = true;

            var worldBounds = [[180,90],[180,-90],[-180,-90],[-180,90],[180,90]];
            var inverseMask = {
                type: 'Feature',
                geometry: {
                    type: 'Polygon',
                    coordinates: [worldBounds, caviteGeoJson.geometry.coordinates[0].slice().reverse()]
                }
            };

            leafletMap = L.map('map', {
                center: [14.2789, 120.8689], zoom: 11, minZoom: 10, maxZoom: 18,
                maxBounds: [[14.05,120.65],[14.50,121.08]], maxBoundsViscosity: 1.0
            });

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 18, attribution: '&copy; OpenStreetMap contributors'
            }).addTo(leafletMap);

            // Blue overlay outside Cavite
            L.geoJSON(inverseMask, {
                style: { color:'transparent', fillColor:'#3b82f6', fillOpacity:0.4, weight:0 },
                interactive: false
            }).addTo(leafletMap);

            // Cavite boundary dashed line
            var cavLayer = L.geoJSON(caviteGeoJson, {
                style: { color:'#2563eb', weight:2.5, fillOpacity:0, dashArray:'8,4' }
            }).addTo(leafletMap);
            leafletMap.fitBounds(cavLayer.getBounds(), { padding:[30,30] });

            leafletMap.on('click', async function(e) {
                await placePin(e.latlng.lat, e.latlng.lng, true);
            });

            [100,300,600].forEach(function(ms){ setTimeout(function(){ leafletMap.invalidateSize(); }, ms); });

            initMapSearch();
        }

        // ── Place / move the pin ──────────────────────────────────────────
        async function placePin(lat, lng, checkBoundary) {
            // 1. Cavite polygon check
            if (checkBoundary && !insideCavite(lat, lng)) {
                Swal.fire({
                    icon:'warning', title:'Outside Cavite',
                    text:'Please select a location within Cavite province only.',
                    confirmButtonColor:'#2563eb', toast:true, position:'top-end',
                    showConfirmButton:false, timer:3000, timerProgressBar:true
                });
                return;
            }
                var manilabaySea = {
            type: 'Feature',
            geometry: {
                type: 'Polygon',
                coordinates: [[
                    [120.6500, 14.5000],
                    [120.9200, 14.5000],
                    [120.9200, 14.4389], // Kawit
                    [120.8789, 14.4289], // Noveleta
                    [120.8456, 14.4089], // Rosario
                    [120.8156, 14.3834], // Tanza
                    [120.7923, 14.3623],
                    [120.7756, 14.3345],
                    [120.7689, 14.3056],
                    [120.7534, 14.2789],
                    [120.7345, 14.2534],
                    [120.7156, 14.2289],
                    [120.6978, 14.2056],
                    [120.6823, 14.1823],
                    [120.6500, 14.1600],
                    [120.6500, 14.5000]
                ]]
            }
        };

        if (turf.booleanPointInPolygon(turf.point([lng, lat]), manilabaySea)) {
            Swal.fire({
                icon: 'warning',
                title: 'Sea Area Detected',
                text: 'That location is in Manila Bay. Please pin a land area inside Cavite.',
                confirmButtonColor: '#2563eb',
                toast: true, position: 'top-end',
                showConfirmButton: false, timer: 3500, timerProgressBar: true
            });
            return;
        }

            // 2. Water check
            document.getElementById('Address').value = 'Checking location…';
            var water = await isWater(lat, lng);
            if (water) {
                document.getElementById('Address').value = '';
                Swal.fire({
                    icon:'warning', title:'Water Area Detected',
                    text:'You clicked on a body of water. Please pin a land location for your store.',
                    confirmButtonColor:'#2563eb', toast:true, position:'top-end',
                    showConfirmButton:false, timer:4000, timerProgressBar:true
                });
                return;
            }

            // 3. Place the marker
            if (mapMarker) {
                mapMarker.setLatLng([lat, lng]);
            } else {
                mapMarker = L.marker([lat, lng], {
                    icon: L.divIcon({
                        className: 'custom-marker',
                        html: '<div style="background:#ef4444;width:32px;height:32px;border-radius:50% 50% 50% 0;transform:rotate(-45deg);border:3px solid white;box-shadow:0 3px 10px rgba(0,0,0,.4)"><div style="width:8px;height:8px;background:white;border-radius:50%;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) rotate(45deg)"></div></div>',
                        iconSize:[32,32], iconAnchor:[16,32]
                    })
                }).addTo(leafletMap);
            }

            document.getElementById('latitude').value  = lat.toFixed(6);
            document.getElementById('longitude').value = lng.toFixed(6);
            document.getElementById('Address').value   = 'Loading address…';
            ['City','Country','Zip'].forEach(function(id){ document.getElementById(id).value = ''; });
            setPondErr('err-location', true, '');

            // 4. Reverse geocode
            try {
                var resp = await fetch('/reverse-geocode?lat=' + lat + '&lon=' + lng);
                if (!resp.ok) throw new Error('Geocoding failed');
                var data  = await resp.json();
                var addr  = data.address || {};
                var state = (addr.state || addr.province || '').toLowerCase();

                if (!state.includes('cavite')) {
                    Swal.fire({ icon:'warning', title:'Invalid Location',
                        text:'This location is not within Cavite. Please select another.',
                        confirmButtonColor:'#2563eb' });
                    if (mapMarker) { leafletMap.removeLayer(mapMarker); mapMarker = null; }
                    ['Address','latitude','longitude'].forEach(function(id){ document.getElementById(id).value = ''; });
                    return;
                }

                var city = addr.city || addr.town || addr.village || addr.municipality || '';
                document.getElementById('Address').value = data.display_name || 'Address not found';
                document.getElementById('City').value    = city;
                document.getElementById('Country').value = 'Philippines';
                document.getElementById('Zip').value     = addr.postcode || '';

                mapMarker.bindPopup(
                    '<div style="min-width:140px"><b style="color:#2563eb">' + city + '</b><br>'
                    + '<span style="font-size:12px;color:#666">Cavite, Philippines</span></div>'
                ).openPopup();

            } catch(e) {
                document.getElementById('Address').value = 'Unable to fetch address';
                Swal.fire({ icon:'error', title:'Geocoding Error',
                    text:'Unable to retrieve address. Please try again.',
                    confirmButtonColor:'#2563eb' });
            }
        }

        // ═══════════════════════════════════════════════════════════════════
        //  MAP SEARCH BAR (Nominatim, restricted to Cavite polygon)
        // ═══════════════════════════════════════════════════════════════════
        function initMapSearch() {
            var input   = document.getElementById('mapSearchInput');
            var btn     = document.getElementById('mapSearchBtn');
            var results = document.getElementById('mapSearchResults');
            var timer   = null;

            function hide() { results.style.display = 'none'; results.innerHTML = ''; }

            async function search(q) {
                if (!q || q.length < 2) { hide(); return; }
                var query = q.toLowerCase().includes('cavite') ? q : q + ', Cavite, Philippines';
                var url   = 'https://nominatim.openstreetmap.org/search'
                          + '?format=json&limit=7&addressdetails=1'
                          + '&q='      + encodeURIComponent(query)
                          + '&viewbox=120.65,14.50,121.08,14.05&bounded=1';
                try {
                    var data     = await (await fetch(url, { headers:{'Accept-Language':'en'} })).json();
                    var filtered = data.filter(function(r){ return insideCavite(+r.lat, +r.lon); });

                    if (!filtered.length) {
                        results.innerHTML = '<div class="list-group-item text-muted">No results found inside Cavite.</div>';
                        results.style.display = 'block'; return;
                    }
                    results.innerHTML = '';
                    filtered.forEach(function(r) {
                        var item       = document.createElement('button');
                        item.type      = 'button';
                        item.className = 'list-group-item list-group-item-action';
                        item.textContent = r.display_name;
                        item.addEventListener('click', async function() {
                            hide();
                            input.value = r.display_name;
                            leafletMap.setView([+r.lat, +r.lon], 16);
                            await placePin(+r.lat, +r.lon, false);
                        });
                        results.appendChild(item);
                    });
                    results.style.display = 'block';
                } catch(e) {
                    results.innerHTML = '<div class="list-group-item text-danger">Search failed. Try again.</div>';
                    results.style.display = 'block';
                }
            }

            input.addEventListener('input',   function(){ clearTimeout(timer); timer = setTimeout(function(){ search(input.value.trim()); }, 500); });
            btn.addEventListener('click',     function(){ clearTimeout(timer); search(input.value.trim()); });
            input.addEventListener('keydown', function(e){ if (e.key === 'Enter'){ e.preventDefault(); clearTimeout(timer); search(input.value.trim()); }});
            document.addEventListener('click', function(e){
                var wrapper = document.getElementById('mapSearchWrapper');
                if (wrapper && !wrapper.contains(e.target)) hide();
            });
        }
    </script>
}
