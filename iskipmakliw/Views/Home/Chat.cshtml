@{
    Layout = "_LayoutCustomer";
    ViewData["Title"] = "Customization Chat";
}
@model List<CustomizationChat>

<style>
    .chat-sidebar {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .chat-item {
        transition: all 0.2s ease;
        border-left: 3px solid transparent;
    }

        .chat-item:hover {
            background: rgba(102, 126, 234, 0.1);
            border-left-color: #667eea;
            transform: translateX(2px);
        }

        .chat-item.active {
            background: rgba(102, 126, 234, 0.15);
            border-left-color: #667eea;
        }

    .message-bubble {
        animation: slideIn 0.3s ease;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .viewer-container {
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        border-radius: 12px;
        overflow: hidden;
    }

    #chatBox::-webkit-scrollbar {
        width: 8px;
    }

    #chatBox::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
    }

    #chatBox::-webkit-scrollbar-thumb {
        background: #667eea;
        border-radius: 10px;
    }

        #chatBox::-webkit-scrollbar-thumb:hover {
            background: #5568d3;
        }
</style>

<div class="container-fluid py-4">
    <div class="row g-4">
        <!-- LEFT SIDEBAR: Recent Chats -->
        <div class="col-xl-3 col-lg-4 col-md-12">
            <div class="card h-100 shadow-lg border-0 overflow-hidden">
                <div class="chat-sidebar p-3">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h5 class="mb-0 fw-bold">
                            <i class="bi bi-chat-left-dots me-2"></i>Conversations
                        </h5>
                        <span class="badge bg-white text-primary">@(Model?.GroupBy(c => c.CustomizationOrdersId).Count() ?? 0)</span>
                    </div>
                    <div class="input-group mb-3">
                        <span class="input-group-text bg-white border-0">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text" class="form-control border-0" placeholder="Search chats..." id="searchChats">
                    </div>
                </div>

                <div class="card-body p-0" style="max-height: 70vh; overflow-y: auto;">
                    @if (Model == null || !Model.Any())
                    {
                        <div class="d-flex flex-column justify-content-center align-items-center text-muted py-5">
                            <i class="bi bi-inbox fs-1 mb-3 text-primary"></i>
                            <h6 class="fw-semibold">No conversations yet</h6>
                            <p class="small text-center px-3">Your customization chats will appear here</p>
                        </div>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var chat in Model.GroupBy(c => c.CustomizationOrdersId).Select(g => g.OrderByDescending(x => x.DateSent).First()))
                            {
                                {
                                    var color = chat.DateReceived == null ? "bg-light-primary" : "";
                                    <li class="list-group-item chat-item px-3 py-3 @color"
                                        style="cursor: pointer;"
                                        onclick="loadChat(@chat.CustomizationOrdersId)"
                                        data-order-id="@chat.CustomizationOrdersId">
                                        <div class="d-flex align-items-start gap-2">
                                            <div class="position-relative">
                                                <img src="~/src/assets/img/user-profile.jpeg"
                                                     class="rounded-circle"
                                                     style="width:48px; height:48px; object-fit:cover; border: 3px solid #667eea;" />
                                                <span class="position-absolute bottom-0 end-0 badge rounded-pill bg-success"
                                                      style="width: 12px; height: 12px; padding: 0; border: 2px solid white;"></span>
                                            </div>
                                            <div class="flex-grow-1 overflow-hidden">
                                                <div class="d-flex justify-content-between align-items-center mb-1">
                                                    <h6 class="mb-0 fw-semibold text-black">@chat.Sellers?.Username</h6>
                                                    <small class="text-muted">@chat.DateSent.ToString("MMM dd")</small>
                                                </div>
                                                <p class="mb-0 small text-muted text-truncate">
                                                    @(chat.Message.Length > 40 ? chat.Message.Substring(0, 40) + "..." : chat.Message)
                                                </p>
                                                <div class="mt-1 text-end">
                                                    <span class="badge bg-light text-dark small">
                                                        @chat.DateSent.ToString("hh: mm tt")
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </li>
                                }
                            }
                        </ul>
                    }
                </div>
            </div>
        </div>

        <!-- RIGHT: Chat Area -->
        <div class="col-xl-9 col-lg-8 col-md-12">
            <div id="chatArea" class="card shadow-lg border-0" style="height: 80vh;">
                <div class="d-flex flex-column justify-content-center align-items-center h-100 text-muted">
                    <div class="text-center p-5">
                        <div class="mb-4">
                            <i class="bi bi-chat-square-dots" style="font-size: 4rem; color: #667eea;"></i>
                        </div>
                        <h4 class="fw-bold mb-2">Welcome to Customization Chat</h4>
                        <p class="text-muted">Select a conversation to start messaging and view 3D models</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentOrderId = null;
        let lastMessageId  = 0;
        let pollInterval   = null;

        // ── Search ──────────────────────────────────────────────────
        document.getElementById('searchChats')?.addEventListener('input', function(e) {
            const q = e.target.value.toLowerCase();
            document.querySelectorAll('.chat-item').forEach(item => {
                item.style.display = item.textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        });

        // ── Cancel Order ────────────────────────────────────────────
        $("#chatArea").on("click", "#CancelOrder", function () {
            const orderId = $(this).data("id");
            Swal.fire({
                title: "Cancel Order",
                html: `
                    <h5 class="text-start">Cancellation Reason:</h5>
                    <div style="text-align:left;">
                        <div class="form-check mb-2"><input class="form-check-input cancel-reason" type="radio" name="reason" value="Out of stock"><label class="form-check-label">Out of stock</label></div>
                        <div class="form-check mb-2"><input class="form-check-input cancel-reason" type="radio" name="reason" value="Cancelled by buyer request"><label class="form-check-label">Cancelled by buyer request</label></div>
                        <div class="form-check mb-2"><input class="form-check-input cancel-reason" type="radio" name="reason" value="Pricing error"><label class="form-check-label">Pricing error</label></div>
                        <div class="form-check mb-2"><input class="form-check-input cancel-reason" type="radio" name="reason" value="Delivery issue"><label class="form-check-label">Delivery issue</label></div>
                        <div class="form-check mb-2"><input class="form-check-input cancel-reason" type="radio" name="reason" value="Other"><label class="form-check-label">Other (please specify)</label></div>
                        <textarea id="otherReason" class="form-control mt-2" placeholder="Please specify..." style="display:none;"></textarea>
                    </div>`,
                showCancelButton: true,
                confirmButtonText: "Confirm Cancellation",
                cancelButtonText: "Cancel",
                preConfirm: () => {
                    const selected = document.querySelector(".cancel-reason:checked");
                    if (!selected) { Swal.showValidationMessage("Please select a reason"); return false; }
                    if (selected.value === "Other") {
                        const txt = document.getElementById("otherReason").value.trim();
                        if (txt.length < 5) { Swal.showValidationMessage("Please specify at least 5 characters"); return false; }
                        submitCancellation(orderId, txt);
                    } else {
                        submitCancellation(orderId, selected.value);
                    }
                }
            });
            $(document).on("change", ".cancel-reason", function () {
                this.value === "Other" ? $("#otherReason").slideDown() : $("#otherReason").slideUp().val("");
            });
        });

        function submitCancellation(orderId, reason) {
            sessionStorage.setItem("scrollPos", window.scrollY);
            $.ajax({
                url: "/Home/Cancel3d", method: "POST", data: { Id: orderId, Reason: reason },
                success: () => Swal.fire("Cancelled", "Order has been cancelled successfully.", "success").then(() => location.reload()),
                error:   () => Swal.fire("Error", "Failed to cancel order.", "error")
            });
        }
        window.addEventListener("load", function () {
            const pos = sessionStorage.getItem("scrollPos");
            if (pos) { window.scrollTo(0, parseInt(pos)); sessionStorage.removeItem("scrollPos"); }
        });

        // ── Payment ─────────────────────────────────────────────────
        $("#chatArea").on("click", "#PayOrderTrigger", function(){
            const CustomizationOrderId = $(this).data("Id");
            console.log(CustomizationOrderId);
            $("#PayOrderModal").modal("show");
        });

        $("#chatArea").on("click", "#SubmitPayment", function() {
            const orderId         = currentOrderId || $(this).data("id");
            const paymentMethodId = $("input[name='paymentMethodOnline']:checked").val();
            const billingId       = $("input[name='billings']:checked").val();
            const amount          = parseFloat($("#AmountContainer").val()) || 0;
            const amountInCents   = Math.round(amount * 100);

            if (!paymentMethodId || !billingId || isNaN(amount) || amount <= 0 || amountInCents <= 0) {
                Swal.fire({ title:"Error", text:"Please select payment method, delivery address, and ensure valid price.", icon:"error", confirmButtonText:"OK", buttonsStyling:false, customClass:{confirmButton:"btn btn-primary"} });
                return;
            }
            const formattedPrice = "P " + amount.toFixed(2).replace(/\d(?=(\d{3})+\.)/g, '$&,');
            Swal.fire({
                title:"Confirm Payment", html:`Pay <strong>${formattedPrice}</strong>? You'll be redirected to secure payment.`,
                icon:"question", showCancelButton:true, confirmButtonText:"Yes, Pay Now", cancelButtonText:"Cancel",
                buttonsStyling:false, customClass:{confirmButton:"btn btn-primary", cancelButton:"btn btn-secondary"}
            }).then(result => {
                if (!result.isConfirmed) return;
                $.ajax({
                    url: "/Payments/Pay3dProduct", method: "POST",
                    data: { amount: amountInCents, billings: billingId, PaymentMethodId: paymentMethodId, CustomizationOrdersId: orderId },
                    success: response => {
                        if (response.success && response.redirectUrl) {
                            window.location.href = response.redirectUrl;
                        } else {
                            Swal.fire({ title:"Error", text: response.message || "Payment session failed.", icon:"error", confirmButtonText:"OK", buttonsStyling:false, customClass:{confirmButton:"btn btn-primary"} });
                        }
                    },
                    error: xhr => {
                        console.error("Payment error:", xhr.responseText);
                        Swal.fire({ title:"Error", text:"Payment failed. Try again.", icon:"error", confirmButtonText:"OK", buttonsStyling:false, customClass:{confirmButton:"btn btn-primary"} });
                    }
                });
            });
        });

        // ── Load Chat ────────────────────────────────────────────────
        function loadChat(orderId) {
            if (currentOrderId === orderId) return;
            currentOrderId = orderId;

            if (pollInterval) { clearInterval(pollInterval); pollInterval = null; }

            document.querySelectorAll('.chat-item').forEach(i => i.classList.remove('active'));
            document.querySelector(`[data-order-id="${orderId}"]`)?.classList.add('active');

            const chatArea = document.getElementById("chatArea");
            chatArea.innerHTML = `
                <div class="d-flex justify-content-center align-items-center" style="min-height:70vh;">
                    <div class="text-center">
                        <div class="spinner-border text-primary" role="status" style="width:3rem;height:3rem;"></div>
                        <p class="mt-3 text-muted">Loading conversation...</p>
                    </div>
                </div>`;

            fetch(`/Home/LoadChatPartial?orderId=${orderId}`)
                .then(r => r.text())
                .then(html => {
                    chatArea.innerHTML = html;
                    chatArea.style.height = '80vh';

                    const chatBox = document.getElementById('chatBox');
                    if (chatBox) chatBox.scrollTop = chatBox.scrollHeight;

                    // Get initial lastMessageId
                    fetch(`/Home/GetNewMessages?orderId=${orderId}&lastMessageId=0`)
                        .then(r => r.json())
                        .then(msgs => { lastMessageId = msgs?.length > 0 ? Math.max(...msgs.map(m => m.id)) : 0; })
                        .catch(() => { lastMessageId = 0; })
                        .finally(() => startPolling());

                    // ── 3D VIEWER ─────────────────────────────────────────
                    const canvas = document.getElementById("viewer");
                    if (canvas) {
                        // modelPath is the GLB saved in /3dpurchased/
                        // It already has color + texture baked in — load it directly
                        const modelPath = canvas.dataset.model || "";
                        if (modelPath) {
                            console.log("🎨 Loading baked GLB:", modelPath);
                            initThreeViewer(modelPath);
                        } else {
                            console.warn("No model path found on canvas");
                        }
                    }

                    // ── Send message ──────────────────────────────────────
                    $("#Send").off("click").on("click", function(){
                        const msg = $("#Message").val().trim();
                        if (!msg) return;
                        $.ajax({
                            url: "/Home/SendMessage", method: "POST", data: { Id: orderId, Message: msg },
                            success: () => $("#Message").val(''),
                            error: xhr => console.error(xhr.responseText)
                        });
                    });
                })
                .catch(err => {
                    console.error("Error loading chat:", err);
                    chatArea.innerHTML = `
                        <div class="text-center text-danger p-5">
                            <i class="bi bi-exclamation-triangle fs-1 mb-3"></i>
                            <h5>Failed to load conversation</h5>
                            <p class="text-muted">Please try again later</p>
                        </div>`;
                });
        }

        function startPolling() {
            pollInterval = setInterval(() => {
                if (!currentOrderId || lastMessageId < 0) return;
                fetch(`/Home/GetNewMessages?orderId=${currentOrderId}&lastMessageId=${lastMessageId}`)
                    .then(r => r.json())
                    .then(newMessages => {
                        if (!newMessages?.length) return;
                        const chatBox = document.getElementById('chatBox');
                        if (!chatBox) return;
                        newMessages.forEach(msg => {
                            const isBuyer = msg.isCustomer;
                            const avatar  = "/src/assets/img/user-profile.jpeg";
                            let timeStr   = new Date().toLocaleTimeString('en-US', { hour:'2-digit', minute:'2-digit', hour12:true });
                            if (msg.dateSent) {
                                const d = new Date(msg.dateSent);
                                if (!isNaN(d.getTime())) timeStr = d.toLocaleTimeString('en-US', { hour:'2-digit', minute:'2-digit', hour12:true });
                            }
                            const bubbleClass    = isBuyer ? "buyer" : "seller";
                            const textClass      = isBuyer ? "text-white" : "text-dark";
                            const timeTextClass  = isBuyer ? "text-white-50" : "text-muted";
                            chatBox.insertAdjacentHTML('beforeend', `
                                <div class="d-flex mb-3 ${isBuyer ? "justify-content-end" : "justify-content-start"}">
                                    ${!isBuyer ? `<img src="${avatar}" class="rounded-circle me-2" style="width:32px;height:32px;object-fit:cover;" />` : ''}
                                    <div class="message-bubble ${bubbleClass} p-3 rounded-3 shadow-sm ${textClass}" data-id="${msg.id}">
                                        <div class="mb-1">${msg.message || ''}</div>
                                        <div class="small ${timeTextClass} text-end">${timeStr}</div>
                                    </div>
                                    ${isBuyer ? `<img src="${avatar}" class="rounded-circle ms-2" style="width:32px;height:32px;object-fit:cover;" />` : ''}
                                </div>`);
                        });
                        lastMessageId = Math.max(...newMessages.map(m => m.id));
                        chatBox.scrollTop = chatBox.scrollHeight;
                    })
                    .catch(err => console.error('Polling error:', err));
            }, 1000);
        }


        // ════════════════════════════════════════════════════════════
        // 3D VIEWER — loads baked GLB directly, orbit + zoom enabled
        // ════════════════════════════════════════════════════════════
        function initThreeViewer(modelPath) {
            setTimeout(() => {
                const canvas = document.getElementById("viewer");
                if (!canvas) { console.error("Canvas not found"); return; }
                canvas.title = "Click & drag to rotate · Scroll to zoom";
                canvas.style.cursor = "grab";
                loadScript('https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js', () =>
                    loadScript('https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js', () =>
                        loadScript('https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js', () =>
                            initScene(modelPath, canvas)
                        )
                    )
                );
            }, 100);
        }

        function loadScript(src, cb) {
            if (document.querySelector(`script[src="${src}"]`)) { cb(); return; }
            const s = document.createElement('script');
            s.src = src; s.onload = cb;
            document.head.appendChild(s);
        }

        function initScene(modelPath, canvas) {
            const scene = new THREE.Scene();
            scene.background = new THREE.Color(0x0a0c14);
            scene.fog        = new THREE.FogExp2(0x0a0c14, 0.06);

            const camera = new THREE.PerspectiveCamera(50, canvas.clientWidth / canvas.clientHeight, 0.01, 1000);
            camera.position.set(0, 1.5, 4);

            const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
            renderer.setSize(canvas.clientWidth, canvas.clientHeight);
            renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
            renderer.outputEncoding      = THREE.sRGBEncoding;
            renderer.toneMapping         = THREE.ACESFilmicToneMapping;
            renderer.toneMappingExposure = 1.1;
            renderer.shadowMap.enabled   = true;

            const ambient = new THREE.AmbientLight(0xffffff, 0.7);
            const hemi    = new THREE.HemisphereLight(0xffffff, 0x334, 0.5);
            hemi.position.set(0, 20, 0);
            const dir = new THREE.DirectionalLight(0xffffff, 1.4);
            dir.position.set(5, 10, 7.5); dir.castShadow = true;
            dir.shadow.mapSize.width = dir.shadow.mapSize.height = 2048;
            const rim = new THREE.DirectionalLight(0xffffff, 0.2);
            rim.position.set(-5, 4, -5);
            scene.add(ambient, hemi, dir, rim);

            const grid = new THREE.GridHelper(20, 40, 0x1e2336, 0x1e2336);
            grid.material.opacity = 0.6; grid.material.transparent = true;
            scene.add(grid);

            const controls = new THREE.OrbitControls(camera, renderer.domElement);
            controls.enableDamping   = true;
            controls.dampingFactor   = 0.05;
            controls.enableZoom      = true;
            controls.enablePan       = false;
            controls.autoRotate      = true;
            controls.autoRotateSpeed = 1.0;
            controls.minDistance     = 0.5;
            controls.maxDistance     = 20;

            let autoRotateTimer = null;
            canvas.addEventListener('pointerdown', () => {
                controls.autoRotate = false;
                canvas.style.cursor = 'grabbing';
                clearTimeout(autoRotateTimer);
            });
            canvas.addEventListener('pointerup', () => {
                canvas.style.cursor = 'grab';
                autoRotateTimer = setTimeout(() => { controls.autoRotate = true; }, 3000);
            });
            canvas.addEventListener('wheel', () => {
                controls.autoRotate = false;
                clearTimeout(autoRotateTimer);
                autoRotateTimer = setTimeout(() => { controls.autoRotate = true; }, 3000);
            });

            new THREE.GLTFLoader().load(
                modelPath,
                gltf => {
                    const model = gltf.scene;
                    model.traverse(node => {
                        if (node.isMesh) { node.castShadow = true; node.receiveShadow = true; }
                    });
                    const box    = new THREE.Box3().setFromObject(model);
                    const size   = box.getSize(new THREE.Vector3());
                    const maxDim = Math.max(size.x, size.y, size.z);
                    if (maxDim > 0) model.scale.multiplyScalar(2.2 / maxDim);
                    box.setFromObject(model);
                    model.position.sub(box.getCenter(new THREE.Vector3()));
                    scene.add(model);
                    const s2   = box.getSize(new THREE.Vector3());
                    const dist = Math.max(s2.x, s2.y, s2.z) * 2.5;
                    camera.position.set(0, dist * 0.4, dist);
                    controls.minDistance = dist * 0.3;
                    controls.maxDistance = dist * 5;
                    camera.lookAt(0, 0, 0);
                    console.log("GLB loaded — orbit & zoom enabled");
                },
                xhr => console.log(`Loading: ${(xhr.loaded / xhr.total * 100).toFixed(1)}%`),
                err => console.error("GLB load error:", err)
            );

            (function animate() {
                requestAnimationFrame(animate);
                controls.update();
                renderer.render(scene, camera);
            })();

            new ResizeObserver(() => {
                camera.aspect = canvas.clientWidth / canvas.clientHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(canvas.clientWidth, canvas.clientHeight);
            }).observe(canvas);
        }

    </script>
}