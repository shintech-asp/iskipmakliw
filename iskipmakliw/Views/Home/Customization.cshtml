@{
    ViewData["Title"] = "3D Customization";
    Layout = "_LayoutCustomer";
}

<div class="container py-5">
    <div class="row g-4">
        <!-- 3D Viewer -->
        <div class="col-xl-9 col-lg-8 col-md-12">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h4 class="mb-3 fw-semibold">🪑 Customize Your Own Furniture</h4>
                    <canvas id="viewer" class="w-100 rounded-3 border" style="height: 600px;"></canvas>
                </div>
            </div>
        </div>

        <!-- Customization Controls -->
        <div class="col-xl-3 col-lg-4 col-md-12">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <!-- Model Selector -->
                    <h5 class="fw-semibold mb-3">Select Model</h5>
                    <div class="btn-group w-100 mb-3 d-flex">
                        <button class="btn btn-outline-primary flex-fill" onclick="loadModel('/models/chair.glb')">Chair</button>
                        <button class="btn btn-outline-primary flex-fill" onclick="loadModel('/models/drawer.glb')">Drawer</button>
                        <button class="btn btn-outline-primary flex-fill" onclick="loadModel('/models/table.glb')">Table</button>
                    </div>

                    <!-- Color -->
                    <h5 class="fw-semibold mt-4 mb-2">Change Color</h5>
                    <input type="color" id="colorPicker" class="form-control form-control-color mb-3" value="#ff0000" onchange="changeColor(this.value)">

                    <!-- Texture -->
                    <h5 class="fw-semibold mt-4 mb-2">Apply Texture</h5>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <img src="/textures/oak.jpg" class="img-thumbnail texture-thumb" onclick="applyTexture('/textures/oak.jpg')" />
                        <img src="/textures/synthetic_wood.jpg" class="img-thumbnail texture-thumb" onclick="applyTexture('/textures/synthetic_wood.jpg')" />
                        <img src="/textures/wood_table_worn.jpg" class="img-thumbnail texture-thumb" onclick="applyTexture('/textures/wood_table_worn.jpg')" />
                        <img src="/textures/wooden_planks.jpg" class="img-thumbnail texture-thumb" onclick="applyTexture('/textures/wooden_planks.jpg')" />
                    </div>

                    <!-- Resizing -->
                    <h5 class="fw-semibold mt-4 mb-2">Resize</h5>
                    <div class="mb-2">
                        <label class="form-label">Overall Size</label>
                        <input type="range" id="scaleSlider" class="form-range" min="0.5" max="2" step="0.1" value="1" onchange="changeScale(this.value)">
                        <small id="scaleValue" class="text-muted">1.0</small>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">Width (X)</label>
                        <input type="range" id="widthSlider" class="form-range" min="0.5" max="2" step="0.1" value="1" onchange="changeWidth(this.value)">
                        <small id="widthValue" class="text-muted">1.0</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Height (Y)</label>
                        <input type="range" id="heightSlider" class="form-range" min="0.5" max="2" step="0.1" value="1" onchange="changeHeight(this.value)">
                        <small id="heightValue" class="text-muted">1.0</small>
                    </div>

                    <!-- Buttons -->
                    <div class="d-flex justify-content-between">
                        <button class="btn btn-outline-secondary w-50 me-2" onclick="resetDimensions()">Reset</button>
                        <button class="btn btn-success w-50" type="button" onclick="submitCustomization()">Submit</button>
                    </div>

                    <!-- Hidden Form -->
                    <form id="customizationForm" method="post" asp-action="Customization" asp-controller="Home">
                        <input type="hidden" name="Model" id="selectedModel" />
                        <input type="hidden" name="color" id="selectedColor" />
                        <input type="hidden" name="texture" id="selectedTexture" />
                        <input type="hidden" name="Dimension" id="selectedDimension" />
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Styling -->
<style>
    .texture-thumb {
        width: 60px;
        height: 60px;
        cursor: pointer;
        object-fit: cover;
        transition: transform 0.2s ease;
    }

        .texture-thumb:hover {
            transform: scale(1.05);
            border: 2px solid #0d6efd;
        }
</style>

@section Scripts {
    <script type="importmap">
        {
            "imports": {
                "three": "https://cdn.jsdelivr.net/npm/three@0.150.1/build/three.module.js"
            }
        }
    </script>

    <script type="module">
        import * as THREE from "three";
        import { GLTFLoader } from "https://cdn.jsdelivr.net/npm/three@0.150.1/examples/jsm/loaders/GLTFLoader.js";
        import { OrbitControls } from "https://cdn.jsdelivr.net/npm/three@0.150.1/examples/jsm/controls/OrbitControls.js";

        let scene, camera, renderer, controls, model;
        let currentScale = 1.0, currentWidth = 1.0, currentHeight = 1.0;
        let selectedModelPath = "/models/chair.glb";
        let selectedColor = "#ff0000";
        let selectedTexture = "";
        const dimensions = { scale: 1.0, width: 1.0, height: 1.0 };

        const canvas = document.getElementById("viewer");

        // Scene setup
        scene = new THREE.Scene();
        scene.background = new THREE.Color(0xf0f0f0);

        camera = new THREE.PerspectiveCamera(75, canvas.clientWidth / canvas.clientHeight, 0.1, 1000);
        camera.position.set(0, 2, 4);

        renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
        renderer.setSize(canvas.clientWidth, canvas.clientHeight);
        renderer.shadowMap.enabled = true;

        scene.add(new THREE.AmbientLight(0x404040, 0.6));
        const directionalLight = new THREE.DirectionalLight(0xffffff, 1.0);
        directionalLight.position.set(5, 10, 5);
        directionalLight.castShadow = true;
        scene.add(directionalLight);

        controls = new OrbitControls(camera, renderer.domElement);
        controls.enableDamping = true;

        function centerAndFitModel(object) {
            const box = new THREE.Box3().setFromObject(object);
            const center = box.getCenter(new THREE.Vector3());
            const size = box.getSize(new THREE.Vector3());
            object.position.sub(center);
            const maxDim = Math.max(size.x, size.y, size.z);
            const fov = camera.fov * (Math.PI / 180);
            const distance = Math.abs(maxDim / Math.sin(fov / 2)) * 1.2;
            camera.position.set(distance, distance * 0.5, distance);
            controls.target.set(0, 0, 0);
            controls.update();
        }

        // Load model
        window.loadModel = (path) => {
            selectedModelPath = path;
            const loader = new GLTFLoader();
            loader.load(path, (gltf) => {
                if (model) scene.remove(model);
                model = gltf.scene;
                model.traverse((child) => {
                    if (child.isMesh) {
                        child.material = new THREE.MeshStandardMaterial({ color: 0xcccccc });
                        child.castShadow = true;
                    }
                });
                scene.add(model);
                centerAndFitModel(model);
                updateModelScale();
            });
        };

        window.changeColor = (hex) => {
            selectedColor = hex;
            if (!model) return;
            model.traverse((child) => {
                if (child.isMesh) {
                    child.material.color.set(hex);
                    child.material.map = null;
                }
            });
        };

        window.applyTexture = (path) => {
            selectedTexture = path;
            const loader = new THREE.TextureLoader();
            loader.load(path, (texture) => {
                model.traverse((child) => {
                    if (child.isMesh) {
                        child.material.map = texture;
                        child.material.needsUpdate = true;
                    }
                });
            });
        };

        window.changeScale = (val) => {
            currentScale = parseFloat(val);
            dimensions.scale = currentScale;
            updateModelScale();
            document.getElementById("scaleValue").textContent = val;
        };
        window.changeWidth = (val) => {
            currentWidth = parseFloat(val);
            dimensions.width = currentWidth;
            updateModelScale();
            document.getElementById("widthValue").textContent = val;
        };
        window.changeHeight = (val) => {
            currentHeight = parseFloat(val);
            dimensions.height = currentHeight;
            updateModelScale();
            document.getElementById("heightValue").textContent = val;
        };

        window.resetDimensions = () => {
            currentScale = currentWidth = currentHeight = 1.0;
            dimensions.scale = dimensions.width = dimensions.height = 1.0;
            ["scale", "width", "height"].forEach(id => {
                document.getElementById(`${id}Slider`).value = 1.0;
                document.getElementById(`${id}Value`).textContent = "1.0";
            });
            updateModelScale();
        };

        function updateModelScale() {
            if (!model) return;
            model.scale.set(currentScale * currentWidth, currentScale * currentHeight, currentScale);
        }

        // Submit form to controller
        window.submitCustomization = () => {
            document.getElementById("selectedModel").value = selectedModelPath;
            document.getElementById("selectedColor").value = selectedColor;
            document.getElementById("selectedTexture").value = selectedTexture;
            document.getElementById("selectedDimension").value = JSON.stringify(dimensions);
            document.getElementById("customizationForm").submit();
        };

        // Resize
        window.addEventListener("resize", () => {
            const width = canvas.clientWidth;
            const height = canvas.clientHeight;
            camera.aspect = width / height;
            camera.updateProjectionMatrix();
            renderer.setSize(width, height, false);
        });

        function animate() {
            requestAnimationFrame(animate);
            controls.update();
            renderer.render(scene, camera);
        }
        animate();
        loadModel(selectedModelPath);
    </script>
}
